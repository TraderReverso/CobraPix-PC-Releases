<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========================================================================= -->
    <!-- TEMA VERDE/AMARELO COBRAPIX PC (Identidade Visual Fiel ao Banner)        -->
    <!-- Extraído diretamente do banner oficial: fundo grafite-esmeralda profundo, -->
    <!-- cards em verde escuro tecnológico (#062419), acentos vibrantes em         -->
    <!-- verde esmeralda (#10B981/#1FAF55) e amarelo dourado do logo (#F2D150).    -->
    <!-- ========================================================================= -->

    <!-- Cores de Superfície e Fundo (Idênticas ao Dashboard escuro do Banner) -->
    <!-- Fundo geral da aplicação: verde-grafite profundo (#041410) -->
    <Color x:Key="BgDarkColor">#041410</Color>
    <!-- Sidebar de navegação: tom escuro de alta imersão (#020D0A) -->
    <Color x:Key="SidebarDarkColor">#020D0A</Color>
    <!-- Cabeçalho superior (#03100D) -->
    <Color x:Key="HeaderDarkColor">#03100D</Color>
    <!-- Cards e superfícies principais: verde floresta tecnológico do mockup (#072B1F) -->
    <Color x:Key="CardDarkColor">#072B1F</Color>
    <!-- Hover em cards e botões (#0D3D2D) -->
    <Color x:Key="CardHoverColor">#0D3D2D</Color>
    <!-- Bordas estruturais com brilho sutil verde (#0F4A36) -->
    <Color x:Key="BorderDarkColor">#0F4A36</Color>
    <!-- Bordas iluminadas e realces (#1FAF55) -->
    <Color x:Key="BorderLightColor">#1FAF55</Color>
    <!-- Bordas sutis (#0A3828) -->
    <Color x:Key="BorderSubtleColor">#0A3828</Color>
    <!-- Linhas alternadas em DataGrids e tabelas (#051C15) -->
    <Color x:Key="TableAltRowColor">#051C15</Color>
    <!-- Linha ou registro selecionado (#0F4532) -->
    <Color x:Key="SelectedRowColor">#0F4532</Color>
    <!-- Campos de entrada de texto e ComboBoxes (#031812) -->
    <Color x:Key="InputBgColor">#031812</Color>
    <!-- Superfície interna de containers secundários (#06241A) -->
    <Color x:Key="SurfaceColor">#06241A</Color>

    <!-- Destaque Primário / Identidade de Marca (Amarelo Dourado Ouro do Banner) -->
    <!-- Amarelo retirado da tipografia 'PIX' e das barras do gráfico: #F2D150 / #FFD95A -->
    <Color x:Key="AccentColor">#F2D150</Color>
    <Color x:Key="AccentDarkColor">#D4B128</Color>
    <Color x:Key="AccentHoverColor">#FFED4D</Color>
    <Color x:Key="AccentSubtleColor">#25F2D150</Color>

    <!-- Realce Secundário / Aura da Cobra (Verde Esmeralda do Banner: #1FAF55 / #22C55E) -->
    <Color x:Key="AuraPurpleColor">#1FAF55</Color>
    <Color x:Key="AuraPurpleDarkColor">#073B28</Color>

    <!-- Cores Financeiras e de Estado -->
    <!-- Sucesso / Recebido (Verde Esmeralda do banner #10B981) -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <!-- Alerta / Pendências (Amarelo Ouro #F2D150) -->
    <Color x:Key="WarningColor">#F2D150</Color>
    <!-- Atrasados / Dívidas (Vermelho Financeiro #DC2626) -->
    <Color x:Key="DangerColor">#DC2626</Color>
    <!-- Badge PRO (Amarelo Ouro de Destaque #F2D150) -->
    <Color x:Key="ProBadgeColor">#F2D150</Color>
    <!-- Tag Neutra (#0C3827) -->
    <Color x:Key="TagNeutralBgColor">#0C3827</Color>

    <!-- Cores Oficiais do Ranqueamento por Letras (S, A, B, C, D, E) -->
    <Color x:Key="RankSColor">#FFD95A</Color>
    <Color x:Key="RankAColor">#10B981</Color>
    <Color x:Key="RankBColor">#38BDF8</Color>
    <Color x:Key="RankCColor">#F2D150</Color>
    <Color x:Key="RankDColor">#FB923C</Color>
    <Color x:Key="RankEColor">#EF4444</Color>

    <!-- Tipografia e Contraste Nítido em Fundo Verde Escuro -->
    <!-- Texto principal (Branco puro de alta nitidez #F8FAFC) -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <!-- Texto secundário (Verde-água suave legível #A7E3C7) -->
    <Color x:Key="TextSecondaryColor">#A7E3C7</Color>
    <!-- Texto sutil / rótulos e categorias (#6CB393) -->
    <Color x:Key="TextMutedColor">#6CB393</Color>
    <!-- Texto em botões primários amarelos (Grafite profundo #051A13) -->
    <Color x:Key="AccentForegroundColor">#051A13</Color>

    <!-- ========================================================================= -->
    <!-- Brushes Prontos para Uso (DynamicResource e StaticResource)               -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="SidebarDarkBrush" Color="{StaticResource SidebarDarkColor}" />
    <SolidColorBrush x:Key="HeaderDarkBrush" Color="{StaticResource HeaderDarkColor}" />
    <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDarkColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TableAltRowBrush" Color="{StaticResource TableAltRowColor}" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="{StaticResource SelectedRowColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="AuraPurpleBrush" Color="{StaticResource AuraPurpleColor}" />
    <SolidColorBrush x:Key="AuraPurpleDarkBrush" Color="{StaticResource AuraPurpleDarkColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ProBadgeBrush" Color="{StaticResource ProBadgeColor}" />
    <SolidColorBrush x:Key="TagNeutralBgBrush" Color="{StaticResource TagNeutralBgColor}" />

    <SolidColorBrush x:Key="RankSBrush" Color="{StaticResource RankSColor}" />
    <SolidColorBrush x:Key="RankABrush" Color="{StaticResource RankAColor}" />
    <SolidColorBrush x:Key="RankBBrush" Color="{StaticResource RankBColor}" />
    <SolidColorBrush x:Key="RankCBrush" Color="{StaticResource RankCColor}" />
    <SolidColorBrush x:Key="RankDBrush" Color="{StaticResource RankDColor}" />
    <SolidColorBrush x:Key="RankEBrush" Color="{StaticResource RankEColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
</ResourceDictionary>
