<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ========================================================================= -->
    <!-- TEMA CLARO COBRAPIX PC (Branco / Light Elegante e com Profundidade)        -->
    <!-- Fundo cinza-azulado suave, cards brancos bem delimitados com bordas sutis, -->
    <!-- sidebar com diferenciação visual e azul corporativo de alta nitidez        -->
    <!-- ========================================================================= -->

    <!-- Cores de Superfície e Fundo (Diferenciação clara entre Fundo e Cards) -->
    <Color x:Key="BgDarkColor">#EDF2F8</Color>
    <Color x:Key="SidebarDarkColor">#F4F7FB</Color>
    <Color x:Key="HeaderDarkColor">#F8FAFC</Color>
    <Color x:Key="CardDarkColor">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#F8FAFD</Color>
    <Color x:Key="BorderDarkColor">#D1DAE6</Color>
    <Color x:Key="BorderLightColor">#9AAEC4</Color>
    <Color x:Key="BorderSubtleColor">#E2E8F0</Color>
    <Color x:Key="TableAltRowColor">#F8FAFC</Color>
    <Color x:Key="SelectedRowColor">#D6E6F9</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceColor">#E6ECF4</Color>

    <!-- Destaque Corporativo (Azul Royal Profissional de Alto Contraste) -->
    <Color x:Key="AccentColor">#1D68F2</Color>
    <Color x:Key="AccentDarkColor">#1551C4</Color>
    <Color x:Key="AccentHoverColor">#1559D6</Color>
    <Color x:Key="AccentSubtleColor">#1A1D68F2</Color>

    <!-- Detalhes Índigo / Roxo Sutil -->
    <Color x:Key="AuraPurpleColor">#4F46E5</Color>
    <Color x:Key="AuraPurpleDarkColor">#EEF2FF</Color>

    <!-- Cores de Estado e Tags Financeiras -->
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="ProBadgeColor">#B45309</Color>
    <Color x:Key="TagNeutralBgColor">#E2E8F0</Color>

    <!-- Cores Oficiais do Ranqueamento por Letras (S, A, B, C, D, E) -->
    <Color x:Key="RankSColor">#B45309</Color>
    <Color x:Key="RankAColor">#15803D</Color>
    <Color x:Key="RankBColor">#1D68F2</Color>
    <Color x:Key="RankCColor">#CA8A04</Color>
    <Color x:Key="RankDColor">#EA580C</Color>
    <Color x:Key="RankEColor">#DC2626</Color>

    <!-- Tipografia e Contraste Nítido em Fundo Claro (Sem textos apagados) -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#334155</Color>
    <Color x:Key="TextMutedColor">#596A82</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>

    <!-- Brushes Prontos para Uso -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="SidebarDarkBrush" Color="{StaticResource SidebarDarkColor}" />
    <SolidColorBrush x:Key="HeaderDarkBrush" Color="{StaticResource HeaderDarkColor}" />
    <SolidColorBrush x:Key="CardDarkBrush" Color="{StaticResource CardDarkColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="TableAltRowBrush" Color="{StaticResource TableAltRowColor}" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="{StaticResource SelectedRowColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <SolidColorBrush x:Key="AuraPurpleBrush" Color="{StaticResource AuraPurpleColor}" />
    <SolidColorBrush x:Key="AuraPurpleDarkBrush" Color="{StaticResource AuraPurpleDarkColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="ProBadgeBrush" Color="{StaticResource ProBadgeColor}" />
    <SolidColorBrush x:Key="TagNeutralBgBrush" Color="{StaticResource TagNeutralBgColor}" />

    <SolidColorBrush x:Key="RankSBrush" Color="{StaticResource RankSColor}" />
    <SolidColorBrush x:Key="RankABrush" Color="{StaticResource RankAColor}" />
    <SolidColorBrush x:Key="RankBBrush" Color="{StaticResource RankBColor}" />
    <SolidColorBrush x:Key="RankCBrush" Color="{StaticResource RankCColor}" />
    <SolidColorBrush x:Key="RankDBrush" Color="{StaticResource RankDColor}" />
    <SolidColorBrush x:Key="RankEBrush" Color="{StaticResource RankEColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />
</ResourceDictionary>
