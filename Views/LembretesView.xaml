<UserControl x:Class="CobraPix_PC.Views.LembretesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vmm="clr-namespace:CobraPix_PC.ViewModels.Modules"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vmm:LembretesViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Header com KPIs -->
            <RowDefinition Height="Auto" />
            <!-- 1. Alertas de Sucesso e Erro -->
            <RowDefinition Height="Auto" />
            <!-- 2. Conteúdo Principal (Formulário à esquerda + Lista de Lembretes à direita) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. CABEÇALHO DO MÓDULO E CONTADORES KPI                  -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título e Descrição -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Lembretes &amp; Tarefas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Gestão inteligente de mensagens, compromissos, prazos, prioridades e notificações recorrentes"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- KPI Cards Resumo -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pendentes -->
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pendentes: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalPendingCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Hoje -->
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hoje: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Atrasados -->
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Atrasados: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OverdueCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Concluídos -->
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Concluídos: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompletedCount}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1. ALERTAS / MENSAGENS (Sucesso / Erro)                  -->
        <!-- ======================================================== -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <!-- Mensagem de Erro -->
            <Border Background="{DynamicResource TagNeutralBgBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage, Converter={x:Null}}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️ " FontSize="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Mensagem de Sucesso -->
            <Border Background="{DynamicResource TagNeutralBgBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SuccessMessage, Converter={x:Null}}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅ " FontSize="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ======================================================== -->
        <!-- 2. CONTEÚDO PRINCIPAL (LAYOUT 2 COLUNAS)                 -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Coluna 0: Formulário de Cadastro / Edição -->
                <ColumnDefinition Width="380" />
                <!-- Divisor -->
                <ColumnDefinition Width="16" />
                <!-- Coluna 1: Abas, Filtros e Lista de Lembretes -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== -->
            <!-- COLUNA ESQUERDA: FORMULÁRIO                          -->
            <!-- ==================================================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Cabeçalho do Card -->
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding NewReminderCommand}"
                                    HorizontalAlignment="Right"
                                    Height="28"
                                    Padding="8,0"
                                    FontSize="11"
                                    Content="➕ Novo" />
                        </Grid>

                        <!-- Campo: Título -->
                        <TextBlock Text="Título do Lembrete *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Margin="0,0,0,12" />

                        <!-- Campo: Descrição / Observações -->
                        <TextBlock Text="Descrição / Detalhes"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="65"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,12" />

                        <!-- Campo: Checkbox Possui Prazo -->
                        <CheckBox IsChecked="{Binding HasDueDate}"
                                  Content="Definir data e horário de vencimento"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,8" />

                        <!-- Campos Data e Hora (Condicionais) -->
                        <Grid Margin="0,0,0,12"
                              Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Data de Vencimento"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding DueDateInput}"
                                            Height="34" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hora (HH:mm)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding DueTimeInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" />
                            </StackPanel>
                        </Grid>

                        <!-- Campo: Prioridade e Categoria em 2 colunas -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Prioridade -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prioridade"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox SelectedItem="{Binding SelectedPriority}"
                                          ItemsSource="{Binding PrioritiesList}"
                                          Height="34"
                                          Background="{DynamicResource SurfaceBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Categoria -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Categoria"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding CategoryInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34" />
                            </StackPanel>
                        </Grid>

                        <!-- Campo: Recorrência -->
                        <TextBlock Text="Repetição Automática"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding SelectedRecurrence}"
                                  ItemsSource="{Binding RecurrencesList}"
                                  Height="34"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,12" />

                        <!-- Campo Intervalo Personalizado (se CustomDays) -->
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding IsCustomRecurrence, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Intervalo em Dias"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding CustomIntervalDays, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" />
                        </StackPanel>

                        <!-- Botões de Ação do Formulário -->
                        <StackPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveReminderCommand}"
                                    Height="38"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Salvar Lembrete" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelEditCommand}"
                                    Height="32"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Cancelar Edição" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================================================== -->
            <!-- COLUNA DIREITA: ABAS, FILTROS E LISTA DE LEMBRETES   -->
            <!-- ==================================================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Linha 0: Barra de Abas e Filtros -->
                    <RowDefinition Height="Auto" />
                    <!-- Linha 1: Lista de Lembretes -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra Superior de Controle -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Linha 1: Segmented Control de Abas -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- Aba Hoje -->
                            <Button Command="{Binding SelectTabCommand}"
                                    CommandParameter="Hoje"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="0,0,6,0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabHoje}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⏰ Hoje" VerticalAlignment="Center" />
                            </Button>

                            <!-- Aba Próximos -->
                            <Button Command="{Binding SelectTabCommand}"
                                    CommandParameter="Próximos"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="0,0,6,0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabProximos}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📅 Próximos" VerticalAlignment="Center" />
                            </Button>

                            <!-- Aba Atrasados -->
                            <Button Command="{Binding SelectTabCommand}"
                                    CommandParameter="Atrasados"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="0,0,6,0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabAtrasados}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⚠️ Atrasados" VerticalAlignment="Center" />
                            </Button>

                            <!-- Aba Concluídos -->
                            <Button Command="{Binding SelectTabCommand}"
                                    CommandParameter="Concluídos"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="0,0,6,0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabConcluidos}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="✅ Concluídos" VerticalAlignment="Center" />
                            </Button>

                            <!-- Aba Todos -->
                            <Button Command="{Binding SelectTabCommand}"
                                    CommandParameter="Todos"
                                    Height="32"
                                    Padding="14,0"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTabTodos}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📑 Todos" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <!-- Linha 2: Busca por texto + Filtro Categoria + Filtro Prioridade + Atualizar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Caixa de Busca -->
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" />

                            <!-- Filtro Categoria -->
                            <ComboBox Grid.Column="2"
                                      SelectedItem="{Binding SelectedFilterCategory}"
                                      ItemsSource="{Binding AvailableCategories}"
                                      Height="32"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />

                            <!-- Filtro Prioridade -->
                            <ComboBox Grid.Column="4"
                                      SelectedItem="{Binding SelectedFilterPriority}"
                                      Height="32"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}">
                                <ComboBoxItem Content="Todas" IsSelected="True" />
                                <ComboBoxItem Content="Baixa" />
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Alta" />
                                <ComboBoxItem Content="Urgente" />
                            </ComboBox>

                            <!-- Botão Recarregar -->
                            <Button Grid.Column="6"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Height="32"
                                    Width="36"
                                    Padding="0"
                                    ToolTip="Atualizar Lista">
                                <TextBlock Text="🔄" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Lista de Lembretes em Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Estado Vazio -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="40"
                                HorizontalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredReminders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="Nenhum lembrete encontrado nesta visualização"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Crie um novo lembrete utilizando o formulário ao lado para gerenciar suas tarefas e prazos."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- ItemsControl com os Lembretes -->
                        <ItemsControl ItemsSource="{Binding FilteredReminders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardDarkBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Ação Rápida: Concluir -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Conteúdo Principal -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Ações Laterais -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Botão Concluir (Esquerda) -->
                                            <Button Grid.Column="0"
                                                    Command="{Binding DataContext.CompleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,14,0"
                                                    Cursor="Hand"
                                                    BorderThickness="0"
                                                    ToolTip="Marcar como Concluído">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="17">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" />
                                            </Button>

                                            <!-- Corpo do Lembrete (Centro) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Título e Badges -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />

                                                    <!-- Badge Categoria -->
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Border>

                                                    <!-- Badge Prioridade -->
                                                    <Border CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource TagNeutralBgBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PriorityLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                                    </Border>

                                                    <!-- Badge Recorrência (se ativa) -->
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="Daily">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="Weekly">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="Monthly">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Recurrence}" Value="CustomDays">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding RecurrenceLabel}" FontSize="10" Foreground="{DynamicResource AccentHoverBrush}" />
                                                    </Border>

                                                    <!-- Badge Adiado -->
                                                    <Border Background="{DynamicResource SurfaceBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SnoozeCount, Converter={x:Null}}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource WarningBrush}">
                                                            <Run Text="💤 Adiado " /><Run Text="{Binding SnoozeCount}" /><Run Text="x" />
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Descrição (se houver) -->
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />

                                                <!-- Data de Vencimento -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⏰ Prazo: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding FormattedDueDate}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ações Rápidas (Direita) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Adiar +1h (apenas se pendente) -->
                                                <Button Command="{Binding DataContext.SnoozeReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="30"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        FontSize="11"
                                                        ToolTip="Adiar por 1 hora">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="⏰ +1h" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Editar -->
                                                <Button Command="{Binding DataContext.EditReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Height="30"
                                                        Padding="8,0"
                                                        Margin="0,0,6,0"
                                                        FontSize="11"
                                                        ToolTip="Editar Lembrete">
                                                    <TextBlock Text="✏️" VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Excluir -->
                                                <Button Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Height="30"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        ToolTip="Excluir Lembrete">
                                                    <TextBlock Text="🗑️" VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
