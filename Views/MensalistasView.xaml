<UserControl x:Class="CobraPix_PC.Views.MensalistasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:MensalistasViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Filtros e Busca -->
            <RowDefinition Height="Auto" />
            <!-- 2. Conteúdo Principal (Lista + Painel) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. CABEÇALHO DO MÓDULO                                   -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título e Subtítulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Clientes Mensalistas"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Controle de mensalidades recorrentes, vencimentos fixos e quitações do mês."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Ações e Faturamento Mensal -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Card de Faturamento Recorrente -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RECEITA RECORRENTE:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{Binding FormattedTotalMonthlyRevenue}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Botão Novo Mensalista -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenNewFormCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⭐" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Novo Mensalista" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1. BARRA DE PESQUISA E FILTROS                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Busca -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <!-- Filtro Segmentado -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Recarregar -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Campo de Pesquisa -->
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,7,28,7"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="🔍"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False" />

                    <TextBlock Text="Pesquisar por cliente ou telefone..."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding ClearSearchCommand}"
                            Content="✕"
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Filtro Segmentado (Todos, Ativos, Inativos) -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <!-- Filtro: Todos -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="All"
                                Cursor="Hand"
                                Padding="12,4"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Todos" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="{DynamicResource TagNeutralBgBrush}" CornerRadius="10" Margin="6,0,0,0" Padding="6,1">
                                    <TextBlock Text="{Binding TotalCount}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Filtro: Ativos -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Active"
                                Cursor="Hand"
                                Padding="12,4"
                                BorderThickness="0"
                                Margin="2,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ativos" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="#12291E" CornerRadius="10" Margin="6,0,0,0" Padding="6,1">
                                    <TextBlock Text="{Binding ActiveCount}" FontSize="10" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Filtro: Inativos -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Inactive"
                                Cursor="Hand"
                                Padding="12,4"
                                BorderThickness="0"
                                Margin="2,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterInactive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Inativos" FontWeight="SemiBold" FontSize="12" />
                                <Border Background="#2A1B1B" CornerRadius="10" Margin="6,0,0,0" Padding="6,1">
                                    <TextBlock Text="{Binding InactiveCount}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Botão Recarregar -->
                <Button Grid.Column="3"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        Command="{Binding LoadCustomersCommand}"
                        ToolTip="Atualizar lista de mensalistas"
                        Margin="12,0,0,0"
                        Width="36"
                        Padding="0">
                    <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. CONTEÚDO PRINCIPAL (LISTA + PAINEL DE DETALHES)       -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Coluna Esquerda: Lista de Mensalistas -->
                <ColumnDefinition Width="*" MinWidth="480" />
                <!-- Coluna Direita: Painel de Detalhes, Quitação e Histórico -->
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- COLUNA ESQUERDA: LISTAGEM -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Cabeçalho das Colunas -->
                        <RowDefinition Height="Auto" />
                        <!-- Lista de Mensalistas -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho das Colunas -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLIENTE / TELEFONE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="VALOR MENSAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="VENCIMENTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Column="4" Text="MÊS ATUAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Lista com Seleção -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredMonthlyCustomers}"
                             SelectedItem="{Binding SelectedMonthlyCustomer}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="{DynamicResource CardDarkBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonthlyCustomerItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cliente e Telefone -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ClientPhone}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Valor Mensal -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FormattedMonthlyAmount}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Dia de Vencimento -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedDueDay}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Status Mensalista (Ativo / Inativo) -->
                                    <Border Grid.Column="3"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#162E20" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#291C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Situação do Mês Atual (Pago / Pendente / Atrasado) -->
                                    <Border Grid.Column="4"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2A2412" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentMonthPaid}" Value="True">
                                                        <Setter Property="Background" Value="#122E1E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrentMonthOverdue}" Value="True">
                                                        <Setter Property="Background" Value="#381818" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#1D2430" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CurrentMonthStatusText}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMonthPaid}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCurrentMonthOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Ação Rápida WhatsApp -->
                                    <Button Grid.Column="5"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.OpenWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="4,2"
                                            Height="24"
                                            Width="28"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ToolTip="Conversar no WhatsApp">
                                        <TextBlock Text="💬" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ESTADO 1: Carregando -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⏳" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Carregando clientes mensalistas..."
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ESTADO 2: Sem Mensalistas Cadastrados -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="360">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⭐" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Nenhum mensalista cadastrado"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Vincule seus clientes a cobranças recorrentes mensais com vencimento fixo."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenNewFormCommand}"
                                Content="+ Cadastrar Primeiro Mensalista"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ESTADO 3: Pesquisa Sem Resultados -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Nenhum mensalista encontrado"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Verifique os termos digitados ou alterne os filtros."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- COLUNA DIREITA: PAINEL DE DETALHES, QUITAÇÃO E HISTÓRICO -->
            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <!-- Estado: Nenhuma Seleção -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="300">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMonthlyCustomer}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="👆" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Selecione um Mensalista"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Escolha um mensalista na lista ao lado para registrar o pagamento do mês, gerenciar o plano ou consultar o histórico de mensalidades."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Conteúdo do Mensalista Selecionado -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedMonthlyCustomer}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Header do Mensalista com Ações Rápidas -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedMonthlyCustomer.ClientName}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedMonthlyCustomer.ClientPhone}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Botões Editar e Ativar/Desativar -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource HeaderActionButtonStyle}"
                                            Command="{Binding OpenWhatsAppCommand}"
                                            ToolTip="Conversar no WhatsApp"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="💬 WhatsApp" FontSize="11" />
                                    </Button>

                                    <Button Style="{StaticResource HeaderActionButtonStyle}"
                                            Command="{Binding OpenEditFormCommand}"
                                            ToolTip="Editar dados da mensalidade"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="✏️ Editar" FontSize="11" />
                                    </Button>

                                    <!-- Botão Desativar/Reativar -->
                                    <Button Command="{Binding ToggleStatusCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Height" Value="34" />
                                                <Setter Property="Padding" Value="10,0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Background" Value="#381818" />
                                                <Setter Property="Foreground" Value="#FFA3A3" />
                                                <Setter Property="BorderBrush" Value="#7F2525" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Content" Value="⏹ Desativar" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#12291E" />
                                                        <Setter Property="Foreground" Value="#6EE7B7" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                        <Setter Property="Content" Value="▶ Reativar" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Cartão de Resumo Financeiro da Recorrência -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MENSALIDADE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedMonthlyCustomer.FormattedMonthlyAmount}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VENCIMENTO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedMonthlyCustomer.FormattedDueDay}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SITUAÇÃO MÊS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedMonthlyCustomer.CurrentMonthStatusText}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsCurrentMonthPaid}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsCurrentMonthOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- =================================================== -->
                            <!-- SEÇÃO: PAGAMENTO DO MÊS ATUAL                       -->
                            <!-- =================================================== -->
                            <TextBlock Text="PAGAMENTO DO MÊS ATUAL"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,0,0,8" />

                            <!-- Cenário A: Mês Atual Já Quitado -->
                            <Border Background="#122A1E"
                                    BorderBrush="#10B981"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsCurrentMonthPaid}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="✅" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Mensalidade Quitada!" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding SelectedMonthlyCustomer.CurrentMonthPayment.FormattedDate, StringFormat='Pago em: {0}'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,2" />

                                    <TextBlock Text="{Binding SelectedMonthlyCustomer.CurrentMonthPayment.FormattedAmount, StringFormat='Valor: {0}'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,0,0,2" />

                                    <TextBlock Text="{Binding SelectedMonthlyCustomer.CurrentMonthPayment.MethodBadge, StringFormat='Método: {0}'}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Cenário B: Mensalista Inativo -->
                            <Border Background="#291C1C"
                                    BorderBrush="#7F2525"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SelectedMonthlyCustomer.IsActive}" Value="False" />
                                                    <Condition Binding="{Binding SelectedMonthlyCustomer.IsCurrentMonthPaid}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="⏸ Mensalista Inativo" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                    <TextBlock Text="Este mensalista está desativado. Clique em 'Reativar' acima para permitir o registro de novas mensalidades."
                                               FontSize="12"
                                               Foreground="#FFA3A3"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Cenário C: Formulário de Quitação do Mês Atual -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsCurrentMonthPaid}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedMonthlyCustomer.IsActive}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <TextBlock Text="{Binding FormattedCurrentCompetence, StringFormat='Competência: {0}'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,10" />

                                    <!-- Campo Valor -->
                                    <TextBlock Text="VALOR DO PAGAMENTO (R$) *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10" />

                                    <!-- Seletor de Método de Pagamento -->
                                    <TextBlock Text="MÉTODO DE PAGAMENTO *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- PIX -->
                                        <Button Grid.Column="0"
                                                Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Pix"
                                                Height="32"
                                                Margin="0,0,4,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPixSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="⚡ PIX" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </Button>

                                        <!-- Dinheiro -->
                                        <Button Grid.Column="1"
                                                Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Cash"
                                                Height="32"
                                                Margin="2,0,2,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="💵 Dinheiro" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </Button>

                                        <!-- Cartão -->
                                        <Button Grid.Column="2"
                                                Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Card"
                                                Height="32"
                                                Margin="2,0,2,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="💳 Cartão" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </Button>

                                        <!-- Outro -->
                                        <Button Grid.Column="3"
                                                Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Other"
                                                Height="32"
                                                Margin="4,0,0,0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOtherSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="📄 Outro" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>

                                    <!-- Campo Observações -->
                                    <TextBlock Text="OBSERVAÇÕES (OPCIONAL)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12" />

                                    <!-- Alerta de Erro de Pagamento -->
                                    <Border Background="#381818"
                                            BorderBrush="#7F2525"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPaymentError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PaymentErrorMessage}"
                                                   FontSize="12"
                                                   Foreground="#FFA3A3"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Botão Confirmar Pagamento -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding RegisterPaymentCommand}"
                                            Height="36">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="💳" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Confirmar Pagamento do Mês" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- =================================================== -->
                            <!-- SEÇÃO: HISTÓRICO DE MENSALIDADES PAGAS             -->
                            <!-- =================================================== -->
                            <TextBlock Text="HISTÓRICO DE MENSALIDADES"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,8,0,8" />

                            <!-- Se não houver pagamentos no histórico -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMonthlyCustomer.HasPayments}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Nenhuma mensalidade registrada até o momento."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Lista de Pagamentos Históricos -->
                            <ItemsControl ItemsSource="{Binding SelectedMonthlyCustomer.Payments}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMonthlyCustomer.HasPayments}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MonthlyPaymentHistoryItemViewModel}">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FormattedReference, StringFormat='Competência: {0}'}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding MethodBadge}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding FormattedDate, StringFormat='Pago em: {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FormattedAmount}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. MODAL / OVERLAY: NOVO / EDITAR MENSALISTA             -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop Escuro -->
            <Border Background="#C0080C14" />

            <!-- Card Central do Formulário -->
            <Border Width="500"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header do Modal -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Configure a mensalidade recorrente e dia de vencimento fixo."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding CancelFormCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Alerta de Erro de Validação -->
                    <Border Background="#381818"
                            BorderBrush="#7F2525"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFormError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FormErrorMessage}"
                                   FontSize="12"
                                   Foreground="#FFA3A3"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Modo Criar: Seleção do Cliente -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="CLIENTE ATIVO *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ActiveClients}"
                                  SelectedItem="{Binding SelectedFormClient}"
                                  DisplayMemberPath="Name"
                                  Height="34"
                                  Margin="0,0,0,14" />
                    </StackPanel>

                    <!-- Modo Editar: Nome do Cliente (Apenas Leitura) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="CLIENTE VINCULADO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding FormClientNameText}"
                                 IsReadOnly="True"
                                 Opacity="0.7"
                                 Margin="0,0,0,14" />
                    </StackPanel>

                    <!-- Grid 2 Colunas: Valor da Mensalidade e Dia de Vencimento -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Valor da Mensalidade -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VALOR MENSAL (R$) *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding FormMonthlyAmountText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Dia do Vencimento -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DIA DE VENCIMENTO (1 a 31) *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding FormDueDay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Grid 2 Colunas: Juros Contratuais e Frequência -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Taxa de Juros Contratual (%) -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="JUROS DO CONTRATO (%)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding FormContractInterestRateText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Frequência / Recorrência -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FREQUÊNCIA DE COBRANÇA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource InputTextBoxStyle}"
                                     Text="Mensal (dia fixo do mês)"
                                     IsReadOnly="True"
                                     Opacity="0.8" />
                        </StackPanel>
                    </Grid>

                    <!-- Painel Informativo de Prévia de Juros (quando taxa informada) -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasContractInterest}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Valor final com juros: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FormattedCalculatedFinalMonthlyAmount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FormattedCalculatedInterestAmount, StringFormat='(+ {0} de juros)'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Campo Observações -->
                    <TextBlock Text="OBSERVAÇÕES (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,20" />

                    <!-- Botões de Ação do Modal -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelFormCommand}"
                                Content="Cancelar" />

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveFormCommand}"
                                Content="Salvar Mensalista" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL / OVERLAY: PRÉ-VISUALIZAÇÃO DO WHATSAPP            -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WhatsAppPreview.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop Escuro -->
            <Border Background="#C0080C14" />

            <!-- Card Central -->
            <Border Width="520"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header do Modal -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pré-visualização do WhatsApp"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Revise a mensagem antes de abrir o aplicativo do WhatsApp."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Alerta de Erro (Telefone inválido ou falha ao abrir) -->
                    <Border Background="#381818"
                            BorderBrush="#7F2525"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WhatsAppPreview.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WhatsAppPreview.ErrorMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FFA8A8"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Dados do Cliente e Cobrança -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding WhatsAppPreview.ClientName}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding WhatsAppPreview.ClientPhone}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WhatsAppPreview.Tipo}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding WhatsAppPreview.Amount}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Campo de Edição da Mensagem -->
                    <TextBlock Text="MENSAGEM (EDITÁVEL):"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding WhatsAppPreview.Message, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />

                    <TextBlock Text="ℹ️ O CobraPix PC abrirá o WhatsApp com esta mensagem pré-preenchida. A mensagem não é enviada automaticamente."
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <!-- Botões de Ação -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="CANCELAR" />

                        <Button Grid.Column="2"
                                Command="{Binding WhatsAppPreview.ConfirmCommand}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#25D366" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22C55E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR WHATSAPP" FontSize="12" FontWeight="Bold" Foreground="#0A111A" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
