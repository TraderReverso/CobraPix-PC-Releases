<UserControl x:Class="CobraPix_PC.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             xmlns:helpers="clr-namespace:CobraPix_PC.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1050"
             d:DataContext="{d:DesignInstance Type=vm:ConfiguracoesViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" MaxWidth="960" HorizontalAlignment="Left">

            <!-- ======================================================== -->
            <!-- Cabeçalho Principal                                       -->
            <!-- ======================================================== -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="⚙️" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Configurações do Sistema"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Gerencie preferências do sistema, notificações locais, sons, aparência, planos e backups do CobraPix PC."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- ======================================================== -->
            <!-- Barra de Notificação Global / Alerta de Status           -->
            <!-- ======================================================== -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,18"
                    Visibility="{Binding ShowSaveSuccess, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- Interface Organizada por Abas                            -->
            <!-- ======================================================== -->
            <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,0,24">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,9"
                                            Margin="0,0,6,10"
                                            Cursor="Hand">
                                        <ContentPresenter ContentSource="Header"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                                            <Setter Property="TextElement.FontWeight" Value="Bold" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="False" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    </Style>
                </TabControl.Resources>

                <!-- ==================================================== -->
                <!-- ABA 0: GERAL                                         -->
                <!-- ==================================================== -->
                <TabItem Header="ℹ️ Geral">
                    <StackPanel Margin="0,12,0,0">
                        <!-- Card: Visão Geral do Sistema -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="💻 " FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="CobraPix PC Desktop — Visão Geral"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Sistema de gestão financeira local e cobranças automatizadas com suporte a Pix e mensalidades."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,20" />

                                <!-- Grade de Status do Sistema -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status 1: Versão -->
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="VERSÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="v1.0.0" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text=".NET 10 WPF" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Status 2: Plano -->
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="PLANO COMERCIAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding PlanNameText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="{Binding ActiveClientsInfoText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Status 3: Agendamento -->
                                    <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="ALERTAS LOCAIS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SchedulerStatusText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="7 horários/dia" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Status 4: Armazenamento -->
                                    <Border Grid.Column="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="BANCO LOCAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="SQLite Offline" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="100% no seu PC" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Informações do Banco de Dados Local -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Arquivo de Banco de Dados Local (SQLite)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding CurrentDatabasePath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="🔒 Seguro e Privado" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>

                                <!-- Atalhos Rápidos -->
                                <TextBlock Text="Acesso Rápido às Configurações:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding SelectTabCommand}" CommandParameter="3"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,8" Margin="0,0,10,8" Cursor="Hand" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔔 " />
                                            <TextBlock Text="Horários de Notificação" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SelectTabCommand}" CommandParameter="2"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,8" Margin="0,0,10,8" Cursor="Hand" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔊 " />
                                            <TextBlock Text="Configurar Som" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SelectTabCommand}" CommandParameter="4"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,8" Margin="0,0,10,8" Cursor="Hand" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " />
                                            <TextBlock Text="Gerenciar Backup" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SelectTabCommand}" CommandParameter="7"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,8" Margin="0,0,10,8" Cursor="Hand" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊 " />
                                            <TextBlock Text="Exportar Excel" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SelectTabCommand}" CommandParameter="5"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,8" Margin="0,0,10,8" Cursor="Hand" FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👑 " />
                                            <TextBlock Text="Plano PRO" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- Card: Iniciar com o Windows (Fase Boot 1.0.4)      -->
                        <!-- ================================================ -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Inicialização do Sistema"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Controle se o CobraPix PC deve iniciar automaticamente junto com o Windows para manter as notificações de cobrança sempre ativas."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap" />

                                <!-- Toggle: Iniciar com o Windows -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Iniciar com o Windows"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Quando ativado, o CobraPix PC inicia automaticamente com o Windows (minimizado) e mantém as notificações de cobrança funcionando em segundo plano."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand"
                                                  Margin="16,0,0,0" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!-- Card: Chave Pix para Cobranças (Fase 4)          -->
                        <!-- ================================================ -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="💳" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Chave Pix para cobranças"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Usada automaticamente nas mensagens de cobrança enviadas pelo WhatsApp."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding PixKey, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Height="38"
                                             Padding="12,0" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SavePixKeyCommand}"
                                            Content="Salvar Chave Pix"
                                            Height="38"
                                            Padding="18,0" />
                                </Grid>

                                <TextBlock Text="Dica: Pode ser CPF, CNPJ, e-mail, celular ou chave aleatória. Deixe vazio para enviar cobranças sem chave Pix."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,4,0,0" />

                                <!-- Feedback ao salvar -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding HasPixKeyFeedback, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ️ " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PixKeyFeedbackMessage}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card: Nome da Empresa / Emissor (Fase 5) -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🏢" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Nome da empresa / emissor"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Utilizado no cabeçalho dos recibos e comprovantes de pagamento em PDF gerados pelo CobraPix PC."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Height="38"
                                             Padding="12,0" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveCompanyNameCommand}"
                                            Content="Salvar Nome"
                                            Height="38"
                                            Padding="18,0" />
                                </Grid>

                                <TextBlock Text="Dica: Exemplo: Gestão CPix, Minha Empresa LTDA. Se deixado vazio, os recibos serão gerados com o padrão COBRAPIX."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,4,0,0" />

                                <!-- Feedback ao salvar -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding HasCompanyNameFeedback, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ️ " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CompanyNameFeedbackMessage}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 1: APARÊNCIA                                     -->
                <!-- ==================================================== -->
                <TabItem Header="🎨 Aparência">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎨" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Aparência e Tema do Sistema"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Indicador do tema ativo -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Tema Atual: "
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ThemeDescriptionText}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Escolha o estilo visual da aplicação. O tema Escuro utiliza uma paleta de alta legibilidade inspirada na estética Solo Leveling; o tema Claro oferece uma experiência corporativa limpa."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,16" />

                                <!-- Seletor de Tema -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Botão Tema Escuro -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Padding="16,14"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetDarkThemeCommand}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="🌙 " FontSize="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="Modo Escuro (Solo Leveling)"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Fundo grafite profundo com neon ciano e detalhes de alta imersão e contraste."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <RadioButton Grid.Column="1"
                                                         IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                                         Command="{Binding SetDarkThemeCommand}"
                                                         GroupName="AppThemeGroup"
                                                         VerticalAlignment="Center"
                                                         Cursor="Hand" />
                                        </Grid>
                                    </Border>

                                    <!-- Botão Tema Claro -->
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Padding="16,14"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetLightThemeCommand}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="☀️ " FontSize="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="Modo Claro (Comercial)"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Ambiente clean com alto contraste, fundo suave e acabamento executivo."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <RadioButton Grid.Column="1"
                                                         IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                                         Command="{Binding SetLightThemeCommand}"
                                                         GroupName="AppThemeGroup"
                                                         VerticalAlignment="Center"
                                                         Cursor="Hand" />
                                        </Grid>
                                    </Border>

                                    <!-- Botão Tema Verde/Amarelo -->
                                    <Border Grid.Column="4"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Padding="16,14"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGreenYellowTheme}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding SetGreenYellowThemeCommand}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="🌿 " FontSize="16" VerticalAlignment="Center" />
                                                    <TextBlock Text="Verde/Amarelo"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Identidade oficial do CobraPix com verde floresta e detalhes amarelos."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <RadioButton Grid.Column="1"
                                                         IsChecked="{Binding IsGreenYellowTheme, Mode=OneWay}"
                                                         Command="{Binding SetGreenYellowThemeCommand}"
                                                         GroupName="AppThemeGroup"
                                                         VerticalAlignment="Center"
                                                         Cursor="Hand" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 2: SOM                                           -->
                <!-- ==================================================== -->
                <TabItem Header="🔊 Som">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🔊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Configuração de Som e Alertas"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Defina como o CobraPix PC emite sons ao disparar lembretes de cobrança e confirmações de horário."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,20" />

                                <!-- Switch: Reproduzir Som -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Emitir Som ao Notificar"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="Toca um som nativo ou personalizado do Windows ao apresentar novos alertas locais."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding SoundEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Cursor="Hand" />
                                    </Grid>
                                </Border>

                                <!-- Seletor de Tipo de Som Nativo -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Som Nativo do Windows"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="Selecione um dos sons padrão fornecidos pelo Windows Media."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,10" />

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableSounds}"
                                                      SelectedItem="{Binding SelectedSoundOption, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      Height="36"
                                                      VerticalContentAlignment="Center"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      Background="{DynamicResource InputBgBrush}"
                                                      BorderBrush="{DynamicResource BorderDarkBrush}" />

                                            <Button Grid.Column="2"
                                                    Command="{Binding TestSoundCommand}"
                                                    Content="🔊 Testar Som"
                                                    Height="36"
                                                    Padding="16,0"
                                                    Cursor="Hand"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    FontWeight="SemiBold" />
                                        </Grid>

                                        <TextBlock Text="{Binding SelectedSoundOption.Description}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Arquivo Personalizado WAV -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Som Personalizado (.wav)"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="Você pode utilizar qualquer arquivo de áudio no formato .wav para os seus alertas."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,0,12" />

                                        <Border Background="{DynamicResource CardDarkBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="🎵 " FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding CustomSoundFileName}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>

                                        <WrapPanel Orientation="Horizontal">
                                            <Button Command="{Binding SelectCustomSoundCommand}"
                                                    Content="📁 Selecionar Arquivo .wav"
                                                    Height="34"
                                                    Padding="16,0"
                                                    Margin="0,0,10,0"
                                                    Cursor="Hand"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    FontWeight="SemiBold" />

                                            <Button Command="{Binding UseSystemSoundCommand}"
                                                    Content="🔄 Restaurar Som do Windows"
                                                    Height="34"
                                                    Padding="16,0"
                                                    Cursor="Hand"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Botão Salvar Áudio -->
                                <Button Command="{Binding SaveSettingsCommand}"
                                        Content="💾 Salvar Configurações de Som"
                                        Height="38"
                                        Padding="20,0"
                                        HorizontalAlignment="Left"
                                        Cursor="Hand"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="#FFFFFF"
                                        FontWeight="Bold"
                                        BorderThickness="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 3: NOTIFICAÇÕES                                  -->
                <!-- ==================================================== -->
                <TabItem Header="🔔 Notificações">
                    <StackPanel Margin="0,12,0,0">

                        <!-- Bloco 1: Preferências Gerais de Notificação -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔔" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Central de Notificações e Lembretes"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Controle o agendamento dos avisos de vencimento, parcelas em atraso e mensalidades."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Switch Ativar Notificações -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Notificações ativadas:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <CheckBox IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Cursor="Hand" />
                                    </StackPanel>
                                </Grid>

                                <!-- Antecedência e Tipos de Alertas -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Coluna Esquerda: Antecedência -->
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock Text="Antecedência dos Avisos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Com quantos dias de antecedência o sistema começará a avisar sobre parcelas e mensalidades."
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                                            <ComboBox ItemsSource="{Binding AdvanceDayOptions}"
                                                      SelectedItem="{Binding SelectedAdvanceOption, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                                      Height="34"
                                                      VerticalContentAlignment="Center"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      Background="{DynamicResource InputBgBrush}"
                                                      BorderBrush="{DynamicResource BorderDarkBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Coluna Direita: Filtros de Alerta -->
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock Text="Tipos de Alertas Ativos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                            <CheckBox Content="Alertas de Parcelas em Atraso"
                                                      IsChecked="{Binding OverdueAlertsEnabled, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="12" Margin="0,0,0,6" Cursor="Hand" />

                                            <CheckBox Content="Alertas de Mensalistas Recorrentes"
                                                      IsChecked="{Binding MonthlyAlertsEnabled, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="12" Margin="0,0,0,6" Cursor="Hand" />

                                            <CheckBox Content="Lembrete do 5º Dia Útil do Mês"
                                                      IsChecked="{Binding FifthBusinessDayAlertEnabled, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      FontSize="12" Cursor="Hand" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bloco 2: 7 Horários de Verificação Diária -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏰" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="7 Horários de Verificação Diária"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="O CobraPix PC verifica débitos e emite lembretes nestes 7 horários programados. Digite livremente (ex: 21:30, 21h30, 08:00 ou 8h00)."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <!-- Badge do Próximo Aviso -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,5"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Próximo Aviso: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding NextScheduledAlarmText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Alerta de Validação de Horário (se houver erro) -->
                                <Border Background="#33EF4444"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding HasHourSlotsError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding HourSlotsErrorMessage}" FontSize="12" Foreground="#EF4444" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Grade em 2 Colunas com os 7 Horários -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Coluna 1: Aviso 1 a Aviso 4 -->
                                    <StackPanel Grid.Column="0">
                                        <!-- Aviso 1 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>

                                        <!-- Aviso 2 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 2" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>

                                        <!-- Aviso 3 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 3" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot3, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>

                                        <!-- Aviso 4 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 4" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot4, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Coluna 2: Aviso 5 a Aviso 7 + Ações Rápidas -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Aviso 5 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 5" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot5, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>

                                        <!-- Aviso 6 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 6" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot6, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>

                                        <!-- Aviso 7 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Aviso 7" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding HourSlot7, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         helpers:TimeMaskHelper.IsTimeMaskEnabled="True"
                                                         Width="110" Height="34" FontSize="14" FontWeight="Bold" TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                                            </Grid>
                                        </Border>

                                        <!-- Botões de Apoio: Padrões e Ordenar -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding ResetDefaultHoursCommand}"
                                                    Content="🔄 Padrões (08..20h)"
                                                    Height="34"
                                                    FontSize="11"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Cursor="Hand" />

                                            <Button Grid.Column="2"
                                                    Command="{Binding SortHourSlotsCommand}"
                                                    Content="🔀 Ordenar Horários"
                                                    Height="34"
                                                    FontSize="11"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    Cursor="Hand" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bloco 3: Painel de Diagnóstico em Tempo Real -->
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="⏱️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Diagnóstico do Agendamento e Relógio Local"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Horário do PC -->
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="HORÁRIO DO PC" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentLocalTimeText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Fuso Horário -->
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="FUSO HORÁRIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CurrentTimeZoneText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Status Agendamento -->
                                    <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="AGENDAMENTO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SchedulerStatusText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Próximo Aviso -->
                                    <Border Grid.Column="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="PRÓXIMO AVISO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding NextScheduledAlarmText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. Última Verificação -->
                                    <Border Grid.Column="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="ÚLTIMA VERIFICAÇÃO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LastVerificationText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bloco 4: Ações da Aba de Notificações -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <!-- Botão: Verificar Notificações Agora (mesma rotina do agendador) -->
                            <Button Command="{Binding CheckNotificationsNowCommand}"
                                    Height="40"
                                    Padding="18,0"
                                    Margin="0,0,12,8"
                                    Cursor="Hand"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontWeight="Bold">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔 " FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Verificar Notificações Agora" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Botão: Salvar Horários e Notificações -->
                            <Button Command="{Binding SaveSettingsCommand}"
                                    Height="40"
                                    Padding="24,0"
                                    Margin="0,0,12,8"
                                    Cursor="Hand"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="#FFFFFF"
                                    FontWeight="Bold"
                                    BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 " FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="Salvar Horários e Notificações" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 4: BACKUP                                        -->
                <!-- ==================================================== -->
                <TabItem Header="💾 Backup">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Backup e Restauração de Dados (.cpb)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Indicador de formato oficial -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4">
                                        <TextBlock Text="Formato .cpb" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="Gere backups criptografados offline com segurança máxima. Os backups contêm todos os clientes, vendas, parcelas e pagamentos registrados no sistema."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,20" />

                                <!-- Último Backup Informações -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Informações do Último Backup Realizado"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding LastBackupInfo}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="✅ Integridade Verificada" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- ======================================================== -->
                                <!-- CARD DE BACKUP AUTOMÁTICO DIÁRIO (Fase 6)                 -->
                                <!-- ======================================================== -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🔄 Backup Automático Diário"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="Gera automaticamente no máximo 1 backup por dia em segundo plano, sem bloquear o uso."
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Toggle / CheckBox de Ativação -->
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"
                                                      Content="Ativado"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Cursor="Hand" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="0,10,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Status do Backup Automático:"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding LastAutoBackupInfo}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Command="{Binding OpenAutoBackupFolderCommand}"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    Padding="10,5"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="Abrir Pasta de Backups Automáticos" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Feedback do Backup -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowBackupSuccess, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BackupStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#33EF4444"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowBackupError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="❌ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BackupStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Botões de Ação de Backup -->
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding CreateBackupCommand}"
                                            Height="38"
                                            Padding="20,0"
                                            Margin="0,0,12,0"
                                            Cursor="Hand"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="#FFFFFF"
                                            FontWeight="Bold"
                                            BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📦 " FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Criar Backup Agora (.cpb)" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding RestoreBackupCommand}"
                                            Height="38"
                                            Padding="20,0"
                                            Cursor="Hand"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            FontWeight="SemiBold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📂 " FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Restaurar Backup (.cpb)" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 5: PRO                                           -->
                <!-- ==================================================== -->
                <TabItem Header="👑 PRO">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👑" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Plano Comercial CobraPix"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Badge do Plano Atual -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Plano atual: " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding PlanNameText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Gerencie seu plano comercial, acompanhe o consumo de clientes ativos e faça upgrade para capacidade ilimitada."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,18" />

                                <!-- Card de Consumo de Clientes -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,14"
                                        Margin="0,0,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Consumo de Clientes Ativos" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ActiveClientsInfoText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ActiveClientsCount, StringFormat='{}{0} Ativos'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Informações da Licença Ativa -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource ProBadgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,12"
                                        Margin="0,0,0,18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasInstalledLicense}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="👑 Licença CobraPix PRO Ativa" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ProBadgeBrush}" />
                                            <TextBlock Text="{Binding LicenseDetailsText}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LicenseExpirationText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Opções de Upgrade PRO (Mensal e Anual) -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Plano Mensal -->
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="PLANO MENSAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding MonthlyPriceText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,8" />
                                            <TextBlock Text="Ideal para flexibilidade operacional com cobrança mensal recorrente via Mercado Pago." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                            <Button Command="{Binding OpenMonthlySubscriptionCommand}" Content="Assinar Plano Mensal" Height="36" Cursor="Hand" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Plano Anual -->
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="PLANO ANUAL " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="⭐ MAIS ECONÔMICO" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding AnnualPriceText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,8" />
                                            <TextBlock Text="Economia de mais de 25% no ano com acesso irrestrito a todos os recursos PRO." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />
                                            <Button Command="{Binding OpenAnnualSubscriptionCommand}" Content="Assinar Plano Anual" Height="36" Cursor="Hand" Background="{DynamicResource AccentBrush}" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 6: ATUALIZAÇÕES                                  -->
                <!-- ==================================================== -->
                <TabItem Header="🚀 Atualizações">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚀" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Atualização do CobraPix PC"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4">
                                        <TextBlock Text="{Binding InstalledVersionText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="Mantenha seu CobraPix atualizado com as últimas melhorias de desempenho, recursos e segurança."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,18" />

                                <!-- Botão Verificar Atualização -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Command="{Binding CheckUpdateCommand}"
                                            Height="38"
                                            Padding="20,0"
                                            Cursor="Hand"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource AccentBrush}"
                                            FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍 " FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Verificar se Há Atualizações" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Mensagens de Status de Atualização -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowUpdateSuccess, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎉 " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowUpdateInfo, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ️ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#33EF4444"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowUpdateError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Painel Exibido quando Nova Versão Estiver Disponível -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="✨ " FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RemoteVersionText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,2"
                                                        Margin="0,0,8,0"
                                                        Visibility="{Binding HasPackageSizeText, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding PackageSizeText, StringFormat='📦 {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border Background="#2210B981"
                                                        BorderBrush="#10B981"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,2"
                                                        Visibility="{Binding HasRemoteSha256, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="🔒 SHA-256 Verificado" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hash SHA-256 do pacote remoto quando disponível -->
                                        <Border Background="{DynamicResource CardDarkBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,6"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding HasRemoteSha256, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Checksum Oficial (SHA-256):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding RemoteSha256}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Notas da versão (Release Notes) -->
                                        <StackPanel Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                            <TextBlock Text="Novidades e Correções:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding ReleaseNotes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                            <TextBlock Text="• " FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Top" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Alerta de segurança pré-atualização -->
                                        <Border Background="#22F59E0B"
                                                BorderBrush="#F59E0B"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,16">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🛡️ " FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Antes de atualizar, recomendamos criar um backup de segurança na aba Backup para garantir a integridade dos seus dados."
                                                           FontSize="11" Foreground="#F59E0B" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Botão Baixar Atualização (visível antes do download) -->
                                        <WrapPanel Orientation="Horizontal" Visibility="{Binding CanStartDownload, Converter={StaticResource BoolToVis}}">
                                            <Button Command="{Binding StartDownloadCommand}"
                                                    Height="38"
                                                    Padding="22,0"
                                                    Cursor="Hand"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Foreground="#FFFFFF"
                                                    FontWeight="Bold"
                                                    BorderThickness="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📥 " FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Text="Baixar Atualização" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <!-- Painel Durante o Download (com Barra de Progresso e Cancelar) -->
                                        <Border Background="{DynamicResource CardDarkBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DownloadStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DownloadPercentageText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Barra de Progresso do Download -->
                                                <ProgressBar Value="{Binding DownloadProgressPercentage}" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,8" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" />

                                                <TextBlock Text="{Binding DownloadProgressText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding CancelDownloadCommand}"
                                                            Height="32"
                                                            Padding="16,0"
                                                            Cursor="Hand"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                                            BorderThickness="1"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            FontWeight="SemiBold">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✕ " FontSize="12" VerticalAlignment="Center" />
                                                            <TextBlock Text="Cancelar" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Painel Pós-Download: Atualização Pronta para Instalar -->
                                        <Border Background="#2210B981"
                                                BorderBrush="#10B981"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding CanApplyUpdate, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🚀 " FontSize="16" VerticalAlignment="Center" />
                                                        <TextBlock Text="Atualização pronta para instalar." FontSize="13" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="#10B981"
                                                            CornerRadius="4"
                                                            Padding="8,2">
                                                        <TextBlock Text="SHA-256 Válido ✓" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    </Border>
                                                </Grid>

                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding InstalledVersionText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="➔" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding RemoteVersionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </WrapPanel>

                                                <TextBlock Text="O CobraPix será fechado temporariamente para que o instalador substitua com segurança os arquivos da aplicação. Seus dados e configurações permanecerão 100% intactos."
                                                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding ApplyUpdateCommand}"
                                                            Height="36"
                                                            Padding="20,0"
                                                            Margin="0,0,10,0"
                                                            Cursor="Hand"
                                                            Background="#10B981"
                                                            BorderBrush="#10B981"
                                                            BorderThickness="1"
                                                            Foreground="#FFFFFF"
                                                            FontWeight="Bold">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚡ " FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="Atualizar agora" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>

                                                    <Button Command="{Binding DismissDownloadCommand}"
                                                            Height="36"
                                                            Padding="18,0"
                                                            Cursor="Hand"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                                            FontWeight="SemiBold">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Fechar" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================================================== -->
                <!-- ABA 7: EXCEL                                         -->
                <!-- ==================================================== -->
                <TabItem Header="📊 Excel">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource CardDarkBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Exportação de Dados para Excel (.xlsx)"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="#10B981"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,4">
                                        <TextBlock Text="7 Abas Formatadas" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="Exporte toda a base de dados real do CobraPix PC em um arquivo Excel (.xlsx) profissional com 7 abas: Clientes, Vendas, Parcelas, Pagamentos, Mensalistas, Pagamentos Mensais e Histórico Financeiro."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,18" />

                                <!-- Botão Exportar para Excel -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Command="{Binding ExportToExcelCommand}"
                                            Height="38"
                                            Padding="22,0"
                                            Cursor="Hand"
                                            Background="#10B981"
                                            Foreground="#FFFFFF"
                                            FontWeight="Bold"
                                            BorderThickness="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📥 " FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Exportar Dados para Excel (.xlsx)" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Mensagens de Status de Exportação -->
                                <Border Background="#2210B981"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowExcelSuccess, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✅ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ExcelStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#33EF4444"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,16"
                                        Visibility="{Binding ShowExcelError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="❌ " FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ExcelStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
