<UserControl x:Class="CobraPix_PC.Views.PagamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:PagamentosViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Filtros e Busca -->
            <RowDefinition Height="Auto" />
            <!-- 2. Conteúdo Principal (Lista + Painel) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. CABEÇALHO DO MÓDULO                                   -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Gestão de Pagamentos"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Registro de quitações, amortizações parciais e consulta de histórico financeiro."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Total Filtrado -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TOTAL NA CONSULTA:"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding FormattedTotalFilteredAmount}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. BARRA DE PESQUISA E FILTROS                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Busca -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <!-- Filtro Segmentado -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Recarregar -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Campo de Pesquisa -->
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,7,28,7"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="🔍"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False" />

                    <TextBlock Text="Pesquisar por cliente, venda ou parcela..."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding ClearSearchCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Content="✕"
                            FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Filtros Segmentados -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <!-- Todas -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="All"
                                Height="30" Padding="12,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Todas" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Pendentes -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Pending"
                                Height="30" Padding="12,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterPending}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pendentes" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PendingCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Vencidas -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Overdue"
                                Height="30" Padding="12,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterOverdue}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Vencidas" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OverdueCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Pagas -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Paid"
                                Height="30" Padding="12,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterPaid}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pagas" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PaidCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Botão Recarregar -->
                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadInstallmentsCommand}"
                        ToolTip="Recarregar dados"
                        Margin="8,0,0,0"
                        Width="36" Height="34" Padding="0">
                    <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. CONTEÚDO PRINCIPAL (LISTA + PAINEL DE PAGAMENTO)       -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Lista de Parcelas -->
                <ColumnDefinition Width="*" />
                <!-- Painel de Pagamento e Histórico -->
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- TABELA DE PARCELAS -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderDarkBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="ORIGEM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="PARC." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="VENCIMENTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="VALOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="PAGO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="SALDO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Lista de Parcelas -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredInstallments}"
                             SelectedItem="{Binding SelectedInstallment}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="14,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InstallmentItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cliente -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ClientName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Descrição da Venda -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SaleDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Parcela # -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding InstallmentNumber, StringFormat='{}#{0}'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Vencimento -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding FormattedDueDate}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Valor -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding FormattedAmount}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Total Pago -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding FormattedTotalPaid}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Saldo -->
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding FormattedRemainingBalance}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Status Badge -->
                                    <Border Grid.Column="7"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2A2010" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                        <Setter Property="Background" Value="#133826" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Background" Value="#381616" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="9"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Estado Vazio -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="400">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="💳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Nenhuma parcela encontrada"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="As parcelas geradas pelas vendas aparecerão aqui para acompanhamento e registro de quitação."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Estado Busca Sem Resultados -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Nenhuma parcela corresponde aos filtros"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Alterne o filtro ou verifique os termos da busca."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAINEL LATERAL: REGISTRO DE PAGAMENTO E HISTÓRICO -->
            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <!-- Quando nenhuma parcela está selecionada -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="320">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedInstallment}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="👈" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Selecione uma Parcela"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Clique em qualquer parcela da lista para registrar pagamentos parciais/totais ou consultar o histórico de amortizações."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Painel Ativo com Parcela Selecionada -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedInstallment}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Identificação da Parcela -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedInstallment.ClientName}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedInstallment.SaleDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedInstallment.FormattedNumber}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding SelectedInstallment.FormattedDueDate, StringFormat='Venc: {0}'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- RESUMO FINANCEIRO (Cards Valor, Já Pago, Saldo) -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Valor Original -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VALOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedInstallment.FormattedAmount}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Já Pago -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="JÁ PAGO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedInstallment.FormattedTotalPaid}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Saldo Restante -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SALDO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedInstallment.FormattedRemainingBalance}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- BANNER DE PARCELA QUITADA (se já paga) -->
                            <Border Background="#133826"
                                    BorderBrush="#1F573C"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,16">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInstallment.IsPaid}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="✅ Parcela Quitada com Sucesso"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding SelectedInstallment.FormattedPaidDate, StringFormat='Data de liquidação: {0}'}"
                                               FontSize="11"
                                               Foreground="#99E6B3"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- MENSAGEM DE SUCESSO DO REGISTRO -->
                            <Border Background="#133826"
                                    BorderBrush="#1F573C"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPaymentSuccess}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding PaymentSuccessMessage}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="{Binding PaymentSuccessSummary}"
                                               FontSize="11"
                                               Foreground="#99E6B3"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- MENSAGEM DE ERRO DE VALIDAÇÃO -->
                            <Border Background="#381818"
                                    BorderBrush="#7F2525"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,14">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPaymentError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PaymentErrorMessage}"
                                           FontSize="12"
                                           Foreground="#FFA3A3"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- FORMULÁRIO DE PAGAMENTO (QUANDO HÁ SALDO A PAGAR) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInstallment.CanPay}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="REGISTRAR PAGAMENTO"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,8" />

                                <!-- Campo Valor do Pagamento + Botão Saldo Total -->
                                <TextBlock Text="VALOR DO PAGAMENTO (R$) *"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="{Binding PaymentAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14"
                                             FontWeight="Bold" />

                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding FillFullBalanceCommand}"
                                            Content="Saldo Total"
                                            ToolTip="Preencher com o saldo restante integral"
                                            Height="32"
                                            Padding="10,0"
                                            Margin="8,0,0,0"
                                            FontSize="11" />
                                </Grid>

                                <!-- Seleção do Método de Pagamento -->
                                <TextBlock Text="MÉTODO DE PAGAMENTO *"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="3"
                                        Margin="0,0,0,12">
                                    <UniformGrid Columns="4">
                                        <!-- PIX -->
                                        <Button Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Pix"
                                                Height="30"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPixSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="PIX" FontSize="11" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Dinheiro (Cash) -->
                                        <Button Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Cash"
                                                Height="30"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Dinheiro" FontSize="11" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Cartão (Card) -->
                                        <Button Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Card"
                                                Height="30"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Cartão" FontSize="11" VerticalAlignment="Center" />
                                        </Button>

                                        <!-- Outro (Other) -->
                                        <Button Command="{Binding SetPaymentMethodCommand}"
                                                CommandParameter="Other"
                                                Height="30"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                             <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOtherSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Outro" FontSize="11" VerticalAlignment="Center" />
                                        </Button>
                                    </UniformGrid>
                                </Border>

                                <!-- Campo Observações -->
                                <TextBlock Text="OBSERVAÇÕES (OPCIONAL)"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,16" />

                                <!-- Botão Registrar Pagamento -->
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding RegisterPaymentCommand}"
                                        Height="38"
                                        Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="💰" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Registrar Pagamento" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- SEÇÃO HISTÓRICO DE PAGAMENTOS -->
                            <TextBlock Text="HISTÓRICO DE PAGAMENTOS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,8" />

                            <!-- Se não há pagamentos ainda -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,14"
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInstallment.PaymentsHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Nenhum pagamento registrado ainda para esta parcela."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center" />
                            </Border>

                            <!-- Lista do Histórico -->
                            <ItemsControl ItemsSource="{Binding SelectedInstallment.PaymentsHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PaymentHistoryItemViewModel}">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FormattedDate}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Notes}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding FormattedAmount}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <Border Background="{DynamicResource CardHoverBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,1"
                                                            Margin="0,2,0,0"
                                                            HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding MethodText}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
