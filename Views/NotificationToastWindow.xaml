<Window x:Class="CobraPix_PC.Views.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Width="360"
        SizeToContent="Height">

    <Border Margin="8"
            Background="#1E293B"
            BorderBrush="#06B6D4"
            BorderThickness="1.5"
            CornerRadius="8"
            Cursor="Hand"
            MouseLeftButtonUp="OnCardClicked">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="4"
                              Color="#000000"
                              Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho do Toast: Ícone, Badge e Botão Fechar -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtIcon"
                           Grid.Column="0"
                           Text="🔔"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <Border Grid.Column="1"
                        HorizontalAlignment="Left"
                        Background="#0F172A"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,2">
                    <TextBlock x:Name="TxtBadge"
                               Text="Aviso"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#06B6D4" />
                </Border>

                <Button Grid.Column="2"
                        Content="✕"
                        Width="22" Height="22"
                        FontSize="11"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Background" Value="#334155" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Corpo: Título e Mensagem -->
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="TxtTitle"
                           Text="Título do Alerta"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="TxtMessage"
                           Text="Detalhes da notificação serão exibidos aqui."
                           FontSize="12"
                           Foreground="#CBD5E1"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Rodapé: Orientação de Clique -->
            <TextBlock Grid.Row="2"
                       Text="Clique para visualizar no CobraPix PC"
                       FontSize="10"
                       Foreground="#64748B"
                       Margin="0,8,0,0" />
        </Grid>
    </Border>
</Window>
