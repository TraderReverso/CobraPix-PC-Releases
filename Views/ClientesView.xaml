<UserControl x:Class="CobraPix_PC.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ClientesViewModel}">

    <Grid Margin="24">
        <!-- Layout Principal: 3 Linhas (Header de Ações, Barra de Busca/Filtros, Conteúdo) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. CABEÇALHO DO MÓDULO                                   -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título e Descrição -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Clientes Cadastrados"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Gerencie a base de clientes, visualize dados de contato e controle arquivamentos."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Ações do Cabeçalho e Contador de Clientes Ativos (Fase 13) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Badge Contador de Clientes Ativos -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="👥 " FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveClientsCounterText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenNewClientCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Novo Cliente" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. BARRA DE PESQUISA E FILTROS                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Campo de Busca -->
                    <ColumnDefinition Width="*" />
                    <!-- Espaçamento -->
                    <ColumnDefinition Width="16" />
                    <!-- Segmented Control de Filtros -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Botão Recarregar -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Campo de Pesquisa com Ícone e Limpeza -->
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,7,28,7"
                             VerticalContentAlignment="Center" />

                    <!-- Ícone de Lupa -->
                    <TextBlock Text="🔍"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False" />

                    <!-- Placeholder / Marca d'água -->
                    <TextBlock Text="Pesquisar por nome ou telefone..."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Botão Limpar Busca ✕ -->
                    <Button Command="{Binding ClearSearchCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Content="✕"
                            FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Filtro Segmentado (Ativos / Todos / Arquivados) -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <!-- Filtro: Ativos -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Active"
                                Height="30"
                                Padding="12,0"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ativos" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveCount, StringFormat=' ({0})'}"
                                           FontSize="11"
                                           Opacity="0.8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Filtro: Todos -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="All"
                                Height="30"
                                Padding="12,0"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Todos" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}"
                                           FontSize="11"
                                           Opacity="0.8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Filtro: Arquivados -->
                        <Button Command="{Binding SetFilterCommand}"
                                CommandParameter="Archived"
                                Height="30"
                                Padding="12,0"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterArchived}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Arquivados" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ArchivedCount, StringFormat=' ({0})'}"
                                           FontSize="11"
                                           Opacity="0.8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Botão Recarregar -->
                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadClientsCommand}"
                        ToolTip="Recarregar Clientes do Banco"
                        Margin="8,0,0,0"
                        Width="36" Height="34" Padding="0">
                    <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. ÁREA DE LISTAGEM E DETALHES                           -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Tabela de Clientes (Coluna Flexível) -->
                <ColumnDefinition Width="*" />
                <!-- Painel Lateral de Detalhes do Cliente Selecionado -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- TABELA / LISTA DE CLIENTES -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Cabeçalho das Colunas -->
                        <RowDefinition Height="40" />
                        <!-- Linhas com Scroll -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CABEÇALHO DA TABELA -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderDarkBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="TELEFONE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="CADASTRO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="AÇÕES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- LISTA COM OS CLIENTES -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredClients}"
                             SelectedItem="{Binding SelectedClient}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="16,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ClientItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cliente (Avatar + Nome) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="32"
                                                CornerRadius="16"
                                                Background="{DynamicResource CardHoverBrush}"
                                                BorderBrush="{DynamicResource AccentDarkBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Telefone -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FormattedPhone}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Data de Cadastro -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedCreatedAt}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Status (Ativo / Arquivado) -->
                                    <Border Grid.Column="3"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#133826" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                        <Setter Property="Background" Value="#222B38" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Ações Rápidas por Linha -->
                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <!-- WhatsApp -->
                                        <Button Command="{Binding DataContext.OpenWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="Conversar no WhatsApp"
                                                Cursor="Hand"
                                                Padding="4"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="💬" FontSize="13" />
                                        </Button>

                                        <!-- Editar -->
                                        <Button Command="{Binding DataContext.OpenEditClientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="Editar Cliente"
                                                Cursor="Hand"
                                                Padding="4"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="✏️" FontSize="13" />
                                        </Button>

                                        <!-- Arquivar (se ativo) -->
                                        <Button Command="{Binding DataContext.RequestArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="Arquivar Cliente"
                                                Cursor="Hand"
                                                Padding="4">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="📁" FontSize="13" />
                                        </Button>

                                        <!-- Reativar (se arquivado) -->
                                        <Button Command="{Binding DataContext.ReactivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="Reativar Cliente"
                                                Cursor="Hand"
                                                Padding="4">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="🔄" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ESTADO 1: Carregando -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Carregando clientes locais..."
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ESTADO 2: Lista Vazia (Sem clientes cadastrados) -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="400">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Nenhum cliente cadastrado ainda"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Cadastre o seu primeiro cliente para iniciar o controle de parcelamentos e vendas no CobraPix."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenNewClientCommand}"
                                Content="+ Cadastrar Primeiro Cliente"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ESTADO 3: Pesquisa Sem Resultados -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Nenhum cliente encontrado"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Tente ajustar os termos da busca ou alternar os filtros."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAINEL LATERAL: DETALHES DO CLIENTE SELECIONADO -->
            <Border Grid.Column="1"
                    Width="300"
                    Margin="16,0,0,0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedClient}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Topo do Perfil -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="60" Height="60"
                                CornerRadius="30"
                                Background="{DynamicResource CardHoverBrush}"
                                BorderBrush="{DynamicResource AccentDarkBrush}"
                                BorderThickness="2"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedClient.Initials}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding SelectedClient.Name}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <!-- Status Badge -->
                        <Border Margin="0,6,0,0"
                                Padding="8,2"
                                CornerRadius="4"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#133826" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedClient.IsArchived}" Value="True">
                                            <Setter Property="Background" Value="#222B38" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelectedClient.StatusText}"
                                       FontSize="10"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClient.IsArchived}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- Informações Detalhadas com ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Telefone -->
                            <TextBlock Text="TELEFONE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedClient.FormattedPhone}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,14" />

                            <!-- Observações -->
                            <TextBlock Text="OBSERVAÇÕES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,14"
                                    MinHeight="60">
                                <TextBlock Text="{Binding SelectedClient.Notes, TargetNullValue='Nenhuma observação informada.'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Data de Cadastro -->
                            <TextBlock Text="CRIADO EM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedClient.FormattedCreatedAt}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,10" />

                            <!-- Última Atualização -->
                            <TextBlock Text="ÚLTIMA ALTERAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SelectedClient.FormattedUpdatedAt}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                            <Border Height="1" Background="{DynamicResource BorderDarkBrush}" Margin="0,16,0,16" />

                            <!-- HISTÓRICO FINANCEIRO DO CLIENTE (Fase 2) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="HISTÓRICO FINANCEIRO"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FormattedClientTotalPaid}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Indicador de Carregando Histórico -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingClientHistory}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Carregando pagamentos..." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Sem Pagamentos -->
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,12"
                                    Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasClientFinancialHistory}" Value="False" />
                                                    <Condition Binding="{Binding IsLoadingClientHistory}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Nenhum pagamento registrado para este cliente."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center" />
                            </Border>

                            <!-- Lista de Pagamentos Registrados -->
                            <ItemsControl ItemsSource="{Binding ClientFinancialHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <!-- Badge Tipo -->
                                                        <Border CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1C2E42" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMonthly}" Value="True">
                                                                            <Setter Property="Background" Value="#382C15" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding TypeBadge}"
                                                                       FontSize="9"
                                                                       FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMonthly}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>

                                                        <TextBlock Text="{Binding FormattedShortDate}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding FormattedAmount}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding PaymentMethodBadge}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Botão Gerar PDF -->
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.GeneratePdfReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#211933"
                                                        BorderBrush="#7C3AED"
                                                        BorderThickness="1"
                                                        ToolTip="Gerar Comprovante em PDF"
                                                        Cursor="Hand"
                                                        Padding="5,3"
                                                        VerticalAlignment="Center">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📄" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Ações no Rodapé do Painel -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenWhatsAppCommand}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💬" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Conversar no WhatsApp" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenEditClientCommand}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✏️" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Editar Dados" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Botão Arquivar se Ativo -->
                        <Button Command="{Binding RequestArchiveCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedClient.IsArchived}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📁" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Arquivar Cliente" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Botão Reativar se Arquivado -->
                        <Button Command="{Binding ReactivateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedClient.IsArchived}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reativar Cliente" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 4. MODAL / OVERLAY DE FORMULÁRIO (NOVO / EDITAR)         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Fundo Escuro Translúcido -->
            <Border Background="#C0080C14" />

            <!-- Cartão do Formulário -->
            <Border Width="480"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header do Formulário -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding FormTitle}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Preencha os dados do cliente para salvar no banco local."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding CancelFormCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Alerta de Erro de Validação se houver -->
                    <Border Background="#381818"
                            BorderBrush="#7F2525"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFormError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FormErrorMessage}"
                                   FontSize="12"
                                   Foreground="#FFA3A3"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Campo: Nome Completo -->
                    <TextBlock Text="NOME COMPLETO *"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                    <!-- Campo: Telefone / WhatsApp -->
                    <TextBlock Text="TELEFONE / WHATSAPP"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                    <!-- Campo: Observações -->
                    <TextBlock Text="OBSERVAÇÕES (OPCIONAL)"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,24" />

                    <!-- Botões de Ação do Formulário -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelFormCommand}"
                                Content="Cancelar"
                                Margin="0,0,8,0" />

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveClientCommand}"
                                Content="{Binding FormButtonText}"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 5. DIÁLOGO DE CONFIRMAÇÃO (ARQUIVAMENTO)                 -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfirmOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Fundo Escuro Translúcido -->
            <Border Background="#C0080C14" />

            <!-- Cartão de Confirmação -->
            <Border Width="430"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding ConfirmTitle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding ConfirmMessage}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               LineHeight="18"
                               Margin="0,0,0,24" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDialogCommand}"
                                Content="Cancelar"
                                Margin="0,0,8,0" />

                        <Button Grid.Column="1"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding ConfirmDialogCommand}"
                                Content="Sim, Arquivar"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL / OVERLAY: PRÉ-VISUALIZAÇÃO DO WHATSAPP            -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WhatsAppPreview.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop Escuro -->
            <Border Background="#C0080C14" />

            <!-- Card Central -->
            <Border Width="520"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header do Modal -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Conversar pelo WhatsApp"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Revise a mensagem antes de abrir o aplicativo do WhatsApp."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Alerta de Erro (Telefone inválido ou falha ao abrir) -->
                    <Border Background="#381818"
                            BorderBrush="#7F2525"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WhatsAppPreview.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WhatsAppPreview.ErrorMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FFA8A8"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Dados do Cliente -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding WhatsAppPreview.ClientName}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding WhatsAppPreview.ClientPhone}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WhatsAppPreview.Tipo}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Campo de Edição da Mensagem -->
                    <TextBlock Text="MENSAGEM (EDITÁVEL):"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding WhatsAppPreview.Message, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />

                    <TextBlock Text="ℹ️ O CobraPix PC abrirá o WhatsApp com esta mensagem pré-preenchida. A mensagem não é enviada automaticamente."
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <!-- Botões de Ação -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="CANCELAR" />

                        <Button Grid.Column="2"
                                Command="{Binding WhatsAppPreview.ConfirmCommand}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#25D366" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22C55E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR WHATSAPP" FontSize="12" FontWeight="Bold" Foreground="#0A111A" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 4. MODAL OVERLAY: FEEDBACK COMPROVANTE PDF               -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="3"
              Margin="-24"
              Background="#B2000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPdfSuccessOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="500"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PdfFeedbackTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Button Command="{Binding ClosePdfFeedbackCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Right"
                                Cursor="Hand" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,18">
                        <TextBlock Text="{Binding PdfFeedbackMessage}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClosePdfFeedbackCommand}"
                                Content="FECHAR"
                                Height="36" />

                        <Button Grid.Column="2"
                                Command="{Binding OpenPdfCommand}"
                                IsEnabled="{Binding CanOpenPdf}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#7C3AED" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📖" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR PDF" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
