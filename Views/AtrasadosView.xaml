<UserControl x:Class="CobraPix_PC.Views.AtrasadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:AtrasadosViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0. Cabeçalho -->
            <RowDefinition Height="Auto" />
            <!-- 1. Cards de Métricas -->
            <RowDefinition Height="Auto" />
            <!-- 2. Filtros e Pesquisa -->
            <RowDefinition Height="Auto" />
            <!-- 3. Tabela e Detalhes -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. CABEÇALHO DO MÓDULO                                   -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Inadimplentes e Atrasados"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Monitoramento de cobranças em aberto com vencimento ultrapassado e contagem de dias em atraso."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total em Aberto: "
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FormattedTotalOverdueAmount}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1. CARDS DE MÉTRICAS DE INADIMPLÊNCIA                    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total em Atraso -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12">
                <StackPanel>
                    <TextBlock Text="TOTAL ATRASADO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding FormattedTotalOverdueAmount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} pendências'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Quantidade de Pendências -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12">
                <StackPanel>
                    <TextBlock Text="PENDÊNCIAS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding TotalCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Itens vencidos" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Parcelas Atrasadas -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12">
                <StackPanel>
                    <TextBlock Text="PARCELAS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ParcelasCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="De vendas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 4: Mensalidades Atrasadas -->
            <Border Grid.Column="6"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12">
                <StackPanel>
                    <TextBlock Text="MENSALIDADES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MensalidadesCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Recorrentes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 5: Maior Atraso -->
            <Border Grid.Column="8"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12">
                <StackPanel>
                    <TextBlock Text="MAIOR ATRASO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MaxDaysOverdue, StringFormat='{}{0} dias'}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Caso mais antigo" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 6: Clientes com Atraso -->
            <Border Grid.Column="10"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,12">
                <StackPanel>
                    <TextBlock Text="CLIENTES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding UniqueClientsCount}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Com pendências" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. BARRA DE PESQUISA E FILTROS DE TIPO                   -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Campo de Pesquisa -->
                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,7,28,7"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="🔍"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False" />

                    <TextBlock Text="Pesquisar por cliente ou telefone..."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Botão Limpar Busca -->
                    <Button Command="{Binding ClearSearchCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                    </Button>
                </Grid>

                <!-- Barra de Filtros Segmentados -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <!-- Todos -->
                        <Button Command="{Binding SetTypeFilterCommand}"
                                CommandParameter="All"
                                Height="30" Padding="14,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Todos" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Somente Parcelas -->
                        <Button Command="{Binding SetTypeFilterCommand}"
                                CommandParameter="Parcelas"
                                Height="30" Padding="14,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterParcelas}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Parcelas" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ParcelasCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Somente Mensalidades -->
                        <Button Command="{Binding SetTypeFilterCommand}"
                                CommandParameter="Mensalidades"
                                Height="30" Padding="14,0" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterMensalidades}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mensalidades" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MensalidadesCount, StringFormat=' ({0})'}" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Botão Recarregar -->
                <Button Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadDataCommand}"
                        ToolTip="Atualizar pendências"
                        Margin="8,0,0,0"
                        Width="36" Height="34" Padding="0">
                    <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. CONTEÚDO PRINCIPAL (TABELA + PAINEL DE DETALHES)      -->
        <!-- ======================================================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Tabela de Atrasados -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <!-- Painel Lateral de Ações e Detalhes -->
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- TABELA -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho das Colunas -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderDarkBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="TIPO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="REFERÊNCIA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="VENCIMENTO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="ATRASO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="SALDO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="AÇÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Lista de Itens Atrasados -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredAtrasados}"
                             SelectedItem="{Binding SelectedAtrasado}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="16,11">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AtrasadoItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.7*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cliente -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ClientPhone}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <!-- Tipo -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TipoBadge}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>

                                    <!-- Referência -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Reference}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Origem}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- Vencimento -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding FormattedDueDate}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Dias em Atraso (Badge) -->
                                    <Border Grid.Column="4"
                                            Background="#2D1518"
                                            BorderBrush="#502025"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,3"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DaysOverdueText}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                    </Border>

                                    <!-- Saldo Devedor -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding FormattedRemainingBalance}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DangerBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Ação -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.OpenWhatsAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,4"
                                                Height="28"
                                                Margin="0,0,6,0"
                                                ToolTip="Conversar no WhatsApp">
                                            <TextBlock Text="💬" FontSize="11" />
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4"
                                                Height="28">
                                            <TextBlock Text="Pagar" FontSize="11" FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Estado Vazio / Sem Pendências -->
                    <Border Grid.Row="1"
                            Background="Transparent"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                            <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" Opacity="0.8" />
                            <TextBlock Text="Nenhum valor em atraso!"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,4" />
                            <TextBlock Text="Todas as parcelas e mensalidades estão em dia para o filtro selecionado."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- PAINEL LATERAL DE DETALHES -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <!-- Quando há item selecionado -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedAtrasado}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="DETALHES DA PENDÊNCIA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16" />

                        <!-- Cabeçalho do Cliente -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedAtrasado.ClientName}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedAtrasado.ClientPhone}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                                <Border Background="{DynamicResource CardDarkBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,3"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedAtrasado.TipoBadge}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Informações do Atraso -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Referência:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.Reference}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Origem:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.Origem}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Vencimento:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.FormattedDueDate}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Tempo em Atraso:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.DaysOverdueText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,12,0,12" />

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Valor Original:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.FormattedOriginalAmount}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Total Já Pago:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.FormattedTotalPaid}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Saldo Devedor:" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedAtrasado.FormattedRemainingBalance}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Botão de Ação Direcionada -->
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenPaymentCommand}"
                                Height="40"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir Fluxo de Pagamento" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Botão WhatsApp nos Detalhes -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenWhatsAppCommand}"
                                Height="36"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬 " FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="Abrir no WhatsApp" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Estado Vazio quando não há item selecionado -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedAtrasado}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="👆" FontSize="30" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="Selecione uma pendência"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Clique em um item da lista para visualizar os detalhes completos e encaminhar para regularização."
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL / OVERLAY: PRÉ-VISUALIZAÇÃO DO WHATSAPP            -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WhatsAppPreview.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop Escuro -->
            <Border Background="#C0080C14" />

            <!-- Card Central -->
            <Border Width="520"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header do Modal -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Pré-visualização do WhatsApp"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Revise a mensagem antes de abrir o aplicativo do WhatsApp."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Alerta de Erro (Telefone inválido ou falha ao abrir) -->
                    <Border Background="#381818"
                            BorderBrush="#7F2525"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WhatsAppPreview.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WhatsAppPreview.ErrorMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FFA8A8"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Dados do Cliente e Cobrança -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding WhatsAppPreview.ClientName}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding WhatsAppPreview.ClientPhone}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WhatsAppPreview.Tipo}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding WhatsAppPreview.Amount}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource DangerBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Campo de Edição da Mensagem -->
                    <TextBlock Text="MENSAGEM (EDITÁVEL):"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding WhatsAppPreview.Message, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />

                    <TextBlock Text="ℹ️ O CobraPix PC abrirá o WhatsApp com esta mensagem pré-preenchida. A mensagem não é enviada automaticamente."
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <!-- Botões de Ação -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="CANCELAR" />

                        <Button Grid.Column="2"
                                Command="{Binding WhatsAppPreview.ConfirmCommand}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#25D366" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22C55E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR WHATSAPP" FontSize="12" FontWeight="Bold" Foreground="#0A111A" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
