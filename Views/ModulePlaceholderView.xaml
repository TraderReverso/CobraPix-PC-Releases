<UserControl x:Class="CobraPix_PC.Views.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cartão Superior de Apresentação do Módulo -->
        <Border Grid.Row="0"
                Style="{StaticResource ModuleCardStyle}"
                Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Ícone do Módulo -->
                <Border Grid.Column="0"
                        Width="64" Height="64"
                        CornerRadius="12"
                        Background="#1500D2FF"
                        BorderBrush="{DynamicResource AccentDarkBrush}"
                        BorderThickness="1"
                        Margin="0,0,24,0">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="32"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Título, Categoria e Descrição -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#1C2E42"
                                CornerRadius="4"
                                Padding="8,2"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding Category}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>

                        <Border Background="#16382B"
                                CornerRadius="4"
                                Padding="8,2">
                            <TextBlock Text="PRONTO PARA INTEGRAÇÃO"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Title}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,4" />

                    <TextBlock Text="{Binding Description}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área de Conteúdo Placeholder Indicativa -->
        <Border Grid.Row="1"
                Background="#131922"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="32">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="550">
                <TextBlock Text="⚡"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <TextBlock Text="Módulo Estruturado com Sucesso"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="A fundação arquitetural (Fase 1), o banco SQLite local (Fase 2) e as regras de negócio deste módulo (Fase 3) já estão operacionais. O layout de formulários, grids e relatórios deste módulo será inserido na respectiva fase funcional."
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="20" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
