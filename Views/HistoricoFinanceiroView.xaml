<UserControl x:Class="CobraPix_PC.Views.HistoricoFinanceiroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vmm="clr-namespace:CobraPix_PC.ViewModels.Modules"
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vmm:HistoricoFinanceiroViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 0: Cabeçalho com Navegação de Mês/Ano -->
            <RowDefinition Height="Auto" />
            <!-- 1: Cards de Indicadores / Totais Recebidos -->
            <RowDefinition Height="Auto" />
            <!-- 2: Barra de Filtros e Pesquisa -->
            <RowDefinition Height="Auto" />
            <!-- 3: Tabela de Movimentações -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. CABEÇALHO COM NAVEGAÇÃO DE MÊS/ANO                    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Histórico Financeiro"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Registro detalhado de entradas e valores efetivamente recebidos de parcelas e mensalistas."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Botão Exportar CSV -->
                <Button Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource ActionSecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        FontSize="11"
                        ToolTip="Exportar relatório filtrado para arquivo CSV">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📄" Margin="0,0,5,0" />
                        <TextBlock Text="Exportar CSV" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Botão Exportar Excel -->
                <Button Command="{Binding ExportExcelCommand}"
                        Style="{StaticResource ActionSecondaryButtonStyle}"
                        Margin="0,0,12,0"
                        Padding="10,6"
                        FontSize="11"
                        ToolTip="Exportar relatório formatado em planilha Excel (.xlsx)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" Margin="0,0,5,0" />
                        <TextBlock Text="Exportar Excel" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Seletor de Mês/Ano estilo CashFlow Android -->
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousMonthCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="8,4"
                                Cursor="Hand"
                                ToolTip="Mês Anterior"
                                Content="◀" />

                        <TextBlock Text="{Binding MonthYearDisplayName}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />

                        <Button Command="{Binding NextMonthCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource AccentBrush}"
                                FontSize="14"
                                FontWeight="Bold"
                                Padding="8,4"
                                Cursor="Hand"
                                ToolTip="Próximo Mês"
                                Content="▶" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 1. CARDS DE RESUMO (TOTAIS RECEBIDOS NO PERÍODO)         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: TOTAL RECEBIDO (Destaque Principal) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource SuccessBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="TOTAL RECEBIDO"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="💵" FontSize="14" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding FormattedTotalReceived}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock Text="Valores liquidados no período"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: RECEBIDO EM PARCELAS -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="PARCELAS"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding FormattedInstallmentsTotal}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding InstallmentsCount, StringFormat='{}{0} pagamentos de parcelas'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: RECEBIDO EM MENSALIDADES -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="MENSALIDADES"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="⭐" FontSize="14" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding FormattedMonthlyTotal}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding MonthlyCount, StringFormat='{}{0} mensalidades pagas'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 4: TOTAL DE ENTRADAS / MOVIMENTAÇÕES -->
            <Border Grid.Column="6"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="MOVIMENTAÇÕES"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="📋" FontSize="14" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding TotalTransactionsCount}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Entradas no filtro atual"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. BARRA DE FILTROS E PESQUISA                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- Linha 1: Pesquisa + Presets de Período + Reset -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <!-- Pesquisa -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <!-- Presets de Período -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <!-- Reset -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Campo de Pesquisa -->
                    <Grid Grid.Column="0">
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="32,7,28,7"
                                 VerticalContentAlignment="Center" />

                        <TextBlock Text="🔍"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False" />

                        <TextBlock Text="Pesquisar por cliente, parcela, venda ou observações..."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="34,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Command="{Binding ClearSearchCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextMutedBrush}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Content="✕"
                                FontSize="12">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Presets de Período -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Mês Selecionado -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="Month"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriodMonth}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Mês" VerticalAlignment="Center" />
                            </Button>

                            <!-- Hoje -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="Today"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriodToday}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Hoje" VerticalAlignment="Center" />
                            </Button>

                            <!-- 7 Dias -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="Last7Days"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriod7Days}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="7 Dias" VerticalAlignment="Center" />
                            </Button>

                            <!-- 30 Dias -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="Last30Days"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriod30Days}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="30 Dias" VerticalAlignment="Center" />
                            </Button>

                            <!-- Ano Atual -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="CurrentYear"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriodCurrentYear}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Ano" VerticalAlignment="Center" />
                            </Button>

                            <!-- Todas as Datas -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="All"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriodAll}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Todos" VerticalAlignment="Center" />
                            </Button>

                            <!-- Personalizado -->
                            <Button Command="{Binding SetPeriodPresetCommand}"
                                    CommandParameter="Custom"
                                    Height="30" Padding="10,0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPeriodCustom}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Personalizado" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Resetar Filtros -->
                    <Button Grid.Column="4"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetFiltersCommand}"
                            Height="34"
                            Padding="10,0"
                            ToolTip="Redefinir filtros para o padrão"
                            Content="Limpar Filtros" />
                </Grid>

                <!-- Linha 2: DatePickers para Personalizado (se ativo) + Filtros de Tipo + Filtros de Método -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Tipo de Movimentação -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                        <!-- Método de Pagamento -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <!-- DatePickers de Período Personalizado -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Filtro por Tipo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="TIPO:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SetTypeFilterCommand}" CommandParameter="All" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTypeAll}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Todos" FontSize="11" VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SetTypeFilterCommand}" CommandParameter="Installments" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTypeInstallments}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Parcelas" FontSize="11" VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SetTypeFilterCommand}" CommandParameter="Monthly" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTypeMonthly}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Mensalidades" FontSize="11" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Filtro por Método de Pagamento -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MÉTODO:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SetMethodFilterCommand}" CommandParameter="All" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMethodAll}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Todos" FontSize="11" VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SetMethodFilterCommand}" CommandParameter="Pix" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMethodPix}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="PIX" FontSize="11" VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SetMethodFilterCommand}" CommandParameter="Cash" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMethodCash}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Dinheiro" FontSize="11" VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SetMethodFilterCommand}" CommandParameter="Card" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMethodCard}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Cartão" FontSize="11" VerticalAlignment="Center" />
                                </Button>

                                <Button Command="{Binding SetMethodFilterCommand}" CommandParameter="Other" Height="26" Padding="8,0" BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMethodOther}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="Outro" FontSize="11" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Campos de Data Personalizada (visíveis quando IsPeriodCustom = True) -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPeriodCustom}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="DE:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding CustomStartDate, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"
                                    Height="28"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0" />

                        <TextBlock Text="ATÉ:"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding CustomEndDate, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"
                                    Height="28"
                                    VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. TABELA DE MOVIMENTAÇÕES FINANCEIRAS                   -->
        <!-- ======================================================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <!-- Tabela Principal com DataGrid e Scroll Horizontal/Vertical -->
                <DataGrid ItemsSource="{Binding FilteredTransactions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- 1. Data e Hora -->
                        <DataGridTextColumn Header="DATA / HORA"
                                            Binding="{Binding FormattedDate}"
                                            Width="140"
                                            Foreground="{DynamicResource TextMutedBrush}" />

                        <!-- 2. Nome do Cliente -->
                        <DataGridTemplateColumn Header="CLIENTE" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                    <StackPanel VerticalAlignment="Center" Margin="6,2">
                                        <TextBlock Text="{Binding ClientNameUpper}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FormattedPhone}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. Tipo (Parcela vs Mensalidade vs Estorno) -->
                        <DataGridTemplateColumn Header="TIPO" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C2E42" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMonthly}" Value="True">
                                                        <Setter Property="Background" Value="#382C15" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRefund}" Value="True">
                                                        <Setter Property="Background" Value="#381818" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TypeBadge}"
                                                   FontSize="10"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMonthly}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRefund}" Value="True">
                                                            <Setter Property="Foreground" Value="#F87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 4. Descrição / Detalhe -->
                        <DataGridTextColumn Header="DESCRIÇÃO / VENDA"
                                            Binding="{Binding Description}"
                                            Width="*"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- 5. Método de Pagamento -->
                        <DataGridTemplateColumn Header="MÉTODO" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                    <Border Background="{DynamicResource CardHoverBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PaymentMethodBadge}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 6. Valor Efetivamente Recebido / Estornado -->
                        <DataGridTemplateColumn Header="VALOR" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                    <TextBlock Text="{Binding FormattedAmount}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRefund}" Value="True">
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 7. Status Badge -->
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                    <Border CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#133826" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRefund}" Value="True">
                                                        <Setter Property="Background" Value="#381818" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRefunded}" Value="True">
                                                        <Setter Property="Background" Value="#381818" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="9"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRefund}" Value="True">
                                                            <Setter Property="Foreground" Value="#F87171" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRefunded}" Value="True">
                                                            <Setter Property="Foreground" Value="#F87171" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 8. Observações -->
                        <DataGridTextColumn Header="OBSERVAÇÕES"
                                            Binding="{Binding Notes}"
                                            Width="160"
                                            Foreground="{DynamicResource TextMutedBrush}" />

                        <!-- 9. Ações Rápidas (Comprovante PDF + Estornar + WhatsApp) -->
                        <DataGridTemplateColumn Header="AÇÕES" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FinancialTransactionItemViewModel}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Botão Visualizar / Gerar PDF -->
                                        <Button Command="{Binding DataContext.ViewPdfReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#211933"
                                                BorderBrush="#7C3AED"
                                                BorderThickness="1"
                                                ToolTip="Visualizar ou gerar comprovante em PDF"
                                                Cursor="Hand"
                                                Padding="6,3"
                                                Margin="0,0,6,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center" />
                                                <TextBlock Text="PDF" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Botão Estornar Pagamento -->
                                        <Button Command="{Binding DataContext.OpenRefundDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2D1515"
                                                BorderBrush="#DC2626"
                                                BorderThickness="1"
                                                ToolTip="Estornar este pagamento (reabrir parcela e registrar estorno rastreável)"
                                                Cursor="Hand"
                                                Padding="6,3"
                                                Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRefund}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↩" FontSize="11" Margin="0,0,3,0" VerticalAlignment="Center" Foreground="#F87171" />
                                                <TextBlock Text="Estornar" FontSize="10" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Botão WhatsApp -->
                                        <Button Command="{Binding DataContext.OpenWhatsAppReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip="Enviar confirmação pelo WhatsApp"
                                                Cursor="Hand"
                                                Padding="4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="💬" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- ESTADO: Carregando -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Carregando movimentações financeiras..."
                               FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- ESTADO: Vazio Geral (Sem Pagamentos Registrados) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📜" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Nenhum pagamento registrado no sistema."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Os recebimentos de parcelas e mensalistas serão exibidos aqui à medida que forem confirmados."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- ESTADO: Vazio na Busca/Filtro -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Nenhuma entrada encontrada para os filtros selecionados."
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Tente ajustar o período, limpar a pesquisa ou selecionar outro método de pagamento."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,16" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetFiltersCommand}"
                            Content="Redefinir Filtros"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 4. MODAL OVERLAY: PRÉVIA DO WHATSAPP                     -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4"
              Margin="-24"
              Background="#B2000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WhatsAppPreview.IsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="520"
                    MaxWidth="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Enviar Confirmação de Pagamento"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Button Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Right"
                                Cursor="Hand" />
                    </Grid>

                    <TextBlock Text="MENSAGEM DE RECIBO"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,6" />

                    <TextBox Text="{Binding WhatsAppPreview.Message, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="110"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding WhatsAppPreview.CancelCommand}"
                                Content="CANCELAR" />

                        <Button Grid.Column="2"
                                Command="{Binding WhatsAppPreview.ConfirmCommand}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#25D366" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💬" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR NO WHATSAPP" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 5. MODAL OVERLAY: FEEDBACK COMPROVANTE PDF               -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4"
              Margin="-24"
              Background="#B2000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPdfSuccessOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="500"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PdfFeedbackTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Button Command="{Binding ClosePdfFeedbackCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Right"
                                Cursor="Hand" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,18">
                        <TextBlock Text="{Binding PdfFeedbackMessage}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClosePdfFeedbackCommand}"
                                Content="FECHAR"
                                Height="36" />

                        <Button Grid.Column="2"
                                Command="{Binding OpenPdfCommand}"
                                IsEnabled="{Binding CanOpenPdf}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#7C3AED" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📖" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR PDF" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 6. MODAL OVERLAY: FEEDBACK EXPORTAÇÃO CSV / EXCEL        -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4"
              Margin="-24"
              Background="#B2000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExportFeedbackOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="500"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ExportFeedbackTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Button Command="{Binding CloseExportFeedbackCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Right"
                                Cursor="Hand" />
                    </Grid>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,18">
                        <TextBlock Text="{Binding ExportFeedbackMessage}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="20" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseExportFeedbackCommand}"
                                Content="FECHAR"
                                Height="36" />

                        <Button Grid.Column="2"
                                Command="{Binding OpenExportedFileCommand}"
                                IsEnabled="{Binding CanOpenExportedFile}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#2563EB" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📂" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="ABRIR ARQUIVO" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 7. MODAL OVERLAY: ESTORNO DE PAGAMENTO                   -->
        <!-- ======================================================== -->
        <Grid Grid.RowSpan="4"
              Margin="-24"
              Background="#B2000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRefundDialogOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="520"
                    MaxWidth="580"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <!-- Cabeçalho do Modal -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↩" FontSize="20" FontWeight="Bold" Foreground="#F87171" Margin="0,0,8,0" />
                            <TextBlock Text="Estornar Pagamento"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <Button Command="{Binding CloseRefundDialogCommand}"
                                Content="✕"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Right"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Detalhes do Pagamento Selecionado -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Cliente:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedTransactionForRefund.ClientNameUpper}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Operação:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedTransactionForRefund.Description}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Data Original:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedTransactionForRefund.FormattedDate}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Valor do Pagamento:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding SelectedTransactionForRefund.FormattedAmount}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seleção de Modo: Total vs Parcial -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Tipo de Estorno:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Estorno Total (Valor Integral)"
                                         IsChecked="{Binding IsFullRefund}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,0,16,0"
                                         GroupName="RefundType" />
                            <RadioButton Content="Estorno Parcial"
                                         IsChecked="{Binding IsPartialRefund}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         GroupName="RefundType" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Campo Valor a Estornar -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Valor a Estornar (R$):"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding RefundAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Padding="10,6"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Foreground="#F87171" />
                    </StackPanel>

                    <!-- Campo Motivo do Estorno -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Motivo / Justificativa:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding RefundReason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Padding="10,6"
                                 FontSize="12" />
                    </StackPanel>

                    <!-- Alerta e Exigência de Confirmação -->
                    <Border Background="#2D1515"
                            BorderBrush="#DC2626"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="⚠️ Confirmação: Esta ação reabrirá a parcela para pendente ou vencida e atualizará o saldo global devedor do cliente. O estorno ficará registrado no histórico com rastreabilidade completa sem apagar dados anteriores."
                                   FontSize="11"
                                   Foreground="#FCA5A5"
                                   TextWrapping="Wrap"
                                   LineHeight="16" />
                    </Border>

                    <!-- Mensagem de Erro (se houver) -->
                    <TextBlock Text="{Binding RefundErrorMessage}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#EF4444"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRefundError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Botões de Ação -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CloseRefundDialogCommand}"
                                Content="CANCELAR"
                                Height="36" />

                        <Button Grid.Column="2"
                                Command="{Binding ConfirmRefundCommand}"
                                Height="36"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Background" Value="#DC2626" />
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="↩" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="CONFIRMAR ESTORNO" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
