<UserControl x:Class="CobraPix_PC.Views.VendasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CobraPix_PC.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             d:DataContext="{d:DesignInstance Type=vm:VendasViewModel}">

    <Grid Margin="24">
        <!-- Layout Principal: 3 Linhas (Header, Barra de Busca, Conteúdo) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 1. CABEÇALHO DO MÓDULO                                   -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Título e Subtítulo -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Vendas Parceladas"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Controle de vendas com geração automática de parcelas e divisão matemática de centavos."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- Card Resumo + Botão Nova Venda -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardDarkBrush}"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,6"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total Vendido: "
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FormattedTotalSalesAmount}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OpenNewSaleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Nova Venda" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======================================================== -->
        <!-- 2. BARRA DE PESQUISA                                     -->
        <!-- ======================================================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardDarkBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,7,28,7"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="🔍"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               IsHitTestVisible="False" />

                    <TextBlock Text="Pesquisar venda por cliente ou descrição..."
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding ClearSearchCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextMutedBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            Content="✕"
                            FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadSalesCommand}"
                        ToolTip="Recarregar Vendas"
                        Margin="10,0,0,0"
                        Width="36" Height="34" Padding="0">
                    <TextBlock Text="🔄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 3. ÁREA DE LISTAGEM E DETALHES                           -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- TABELA DE VENDAS -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderDarkBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="CLIENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="DESCRIÇÃO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="VALOR TOTAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="PARCELAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="DATA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Lista de Vendas -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredSales}"
                             SelectedItem="{Binding SelectedSale}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="16,12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SaleItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Cliente -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClientName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Descrição -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayDescription}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- Valor Total -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedTotalAmount}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" />

                                    <!-- Parcelas e Resumo -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InstallmentCount, StringFormat='{}{0} parcelas'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- Data da Venda -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding FormattedSaleDate}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Estado Vazio -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="400">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Nenhuma venda registrada ainda"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Crie uma nova venda parcelada para um cliente ativo e as parcelas serão geradas automaticamente."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenNewSaleCommand}"
                                Content="+ Criar Primeira Venda"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Estado Busca Sem Resultados -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Nenhuma venda encontrada"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Tente buscar por outro termo ou nome de cliente."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAINEL LATERAL: DETALHES DA VENDA E PARCELAS -->
            <Border Grid.Column="1"
                    Width="360"
                    Margin="16,0,0,0"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedSale}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Resumo Topo -->
                        <RowDefinition Height="Auto" />
                        <!-- Lista de Parcelas -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="DETALHES DA VENDA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,4" />

                        <TextBlock Text="{Binding SelectedSale.ClientName}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <TextBlock Text="{Binding SelectedSale.DisplayDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,12" />

                        <!-- Cartão de Informações Financeiras -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedSale.FormattedTotalAmount}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DATA DA VENDA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedSale.FormattedSaleDate}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="PARCELAS DESTA VENDA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- Lista de Parcelas da Venda -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedSale.Installments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InstallmentItemViewModel}">
                                    <Border Background="{DynamicResource CardDarkBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,9"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Linha 0: Número, Vencimento e Status -->
                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedNumber}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding FormattedDueDate, StringFormat='Venc: {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="1"
                                                        CornerRadius="3"
                                                        Padding="6,1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#2A2010" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                    <Setter Property="Background" Value="#133826" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Background" Value="#381616" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontSize="9"
                                                               FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- Linha 1: Informações Financeiras (Valor, Pago, Saldo) e Ação -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Valor, Pago, Saldo -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Valor: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding FormattedAmount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />

                                                    <TextBlock Text="Pago: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding FormattedTotalPaid}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />

                                                    <TextBlock Text="Saldo: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding FormattedRemainingBalance}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                </StackPanel>

                                                <!-- Botão Acessar Pagamento -->
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.OpenPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="24"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanPay}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💳" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Pagar" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- 4. MODAL / OVERLAY: NOVA VENDA COM PRÉVIA                -->
        <!-- ======================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="-24">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#C0080C14" />

            <Border Width="560"
                    MaxHeight="650"
                    Background="{DynamicResource CardDarkBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header do Modal -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nova Venda Parcelada"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Selecione o cliente, defina o parcelamento e confira a prévia."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding CancelFormCommand}"
                                    Content="✕"
                                    FontSize="14"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Cursor="Hand" />
                        </Grid>

                        <!-- Mensagem amigável se não houver clientes ativos -->
                        <Border Background="{DynamicResource TagNeutralBgBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveClients}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="⚠️ Atenção" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Cadastre um cliente antes de criar uma venda. Nenhum cliente ativo foi encontrado no sistema."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Alerta de Erro de Validação se houver -->
                        <Border Background="{DynamicResource TagNeutralBgBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFormError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FormErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Campo: Cliente Ativo -->
                        <TextBlock Text="CLIENTE *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ActiveClients}"
                                  SelectedItem="{Binding SelectedFormClient}"
                                  DisplayMemberPath="Name"
                                  Height="34"
                                  Margin="0,0,0,14" />

                        <!-- Grid 2 Colunas: Valor Total e Parcelas -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Valor Total -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VALOR TOTAL (R$) *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding FormAmountText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Quantidade de Parcelas -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="QTD. PARCELAS *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource InputTextBoxStyle}"
                                         Text="{Binding FormInstallmentCount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- Primeiro Vencimento -->
                        <TextBlock Text="PRIMEIRO VENCIMENTO *" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding FormFirstDueDate}"
                                    Height="34"
                                    Margin="0,0,0,14" />

                        <!-- Descrição / Observações -->
                        <TextBlock Text="DESCRIÇÃO DA VENDA (OPCIONAL)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16" />

                        <!-- ======================================================== -->
                        <!-- PRÉVIA DAS PARCELAS (CÁLCULO EXATO DE CENTAVOS)          -->
                        <!-- ======================================================== -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="PRÉVIA DO PARCELAMENTO"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FormattedPreviewTotal, StringFormat='Soma: {0}'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PreviewInstallmentsList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:InstallmentItemViewModel}">
                                            <Border Background="{DynamicResource CardDarkBrush}"
                                                    BorderBrush="{DynamicResource BorderDarkBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,6"
                                                    Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding FormattedNumber}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding FormattedDueDate, StringFormat='Vence em {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="16,0,0,0"
                                                               VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding FormattedAmount}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Botões de Ação -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding CancelFormCommand}"
                                    Content="Cancelar"
                                    Margin="0,0,8,0" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveSaleCommand}"
                                    Content="Confirmar Venda"
                                    Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
